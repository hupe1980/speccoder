{
  "$defs": {
    "ConvergenceRound": {
      "description": "One convergence round, from its commit.",
      "properties": {
        "commit": {
          "description": "The commit that appended it.",
          "type": "string"
        },
        "round": {
          "description": "Round number.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "tasks": {
          "description": "The appended tasks, as `T0NN text`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "round",
        "commit",
        "tasks"
      ],
      "type": "object"
    },
    "Drift": {
      "description": "What changed since a tick: the tick's commit holds the intent\nit was judged against; the checkout's `HEAD` holds the intent now.",
      "properties": {
        "files": {
          "description": "The intent files that differ (project-relative), task lists aside.\nEmpty when the intent is not in git (in place, ignored): it changed,\nwhich file is not known.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requirements": {
          "description": "The requirements the task cites whose line changed, appeared or went\naway: the evidence no longer speaks for them. Empty: what changed is\nelsewhere in the intent.",
          "items": {
            "$ref": "#/$defs/RequirementDrift"
          },
          "type": "array"
        }
      },
      "required": [
        "requirements",
        "files"
      ],
      "type": "object"
    },
    "JourneyStep": {
      "description": "One step of a feature's journey: `spec`, `plan`, `tasks`, `commit`,\n`run`, `review`.",
      "properties": {
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/StepState",
          "description": "Where it is."
        }
      },
      "required": [
        "name",
        "state"
      ],
      "type": "object"
    },
    "LastAttempt": {
      "description": "An attempt that did not pass, as saved under `refs/speccoder/attempts/`.",
      "properties": {
        "outcome": {
          "description": "`verification_failed`, `blocked`, `needs_approval`, `not_demonstrated`, `interrupted`, …",
          "type": "string"
        },
        "reason": {
          "description": "Why.",
          "type": "string"
        },
        "reference": {
          "description": "The ref holding the attempt's tree.",
          "type": "string"
        },
        "run_id": {
          "description": "The agentplane run, when there was one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "outcome",
        "reason",
        "run_id",
        "reference"
      ],
      "type": "object"
    },
    "RequirementDrift": {
      "description": "One cited requirement, as the tick saw it and as the spec has it now.",
      "properties": {
        "id": {
          "description": "`FR-003`.",
          "type": "string"
        },
        "now": {
          "description": "Its line now; `None`: it was removed.",
          "type": [
            "string",
            "null"
          ]
        },
        "then": {
          "description": "Its line when the task was ticked; `None`: it did not exist yet.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "then",
        "now"
      ],
      "type": "object"
    },
    "ReviewTotals": {
      "description": "Counts of [`ReviewItem::state`].",
      "properties": {
        "ambiguous": {
          "default": 0,
          "description": "Requirements two test authors read differently, not yet resolved:\n*Approve and Run* and a gated run wait on them.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "approved": {
          "description": "Approved on their current wording.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "changes_requested": {
          "description": "Changes requested.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "lapsed": {
          "description": "Decided on an earlier wording.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "open": {
          "description": "Never reviewed.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "questions": {
          "default": 0,
          "description": "Questions the documents leave open.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "approved",
        "changes_requested",
        "open",
        "lapsed",
        "questions",
        "ambiguous"
      ],
      "type": "object"
    },
    "SetAside": {
      "description": "Changes saved and set aside so a run could start from the branch tip.",
      "properties": {
        "files": {
          "description": "The files they change, repository-relative.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reference": {
          "description": "The ref holding them.",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "files"
      ],
      "type": "object"
    },
    "StatusTotals": {
      "description": "Counts of [`TaskStatus::state`].",
      "properties": {
        "attested": {
          "description": "Ticked by `speccoder task accept`: a person's attestation, not evidence.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "blocked": {
          "description": "Open and blocked.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "evidence_without_tick": {
          "description": "In place: committed by speccoder, the local tick missing.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "ready": {
          "description": "Open and ready.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "regression_only": {
          "description": "Ticked with regression evidence only.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "description": "Open and skipped by a person.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "stale": {
          "default": 0,
          "description": "Ticks whose cited requirements changed since.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "ticked_without_evidence": {
          "description": "Ticked without a speccoder commit (by a person, or before speccoder).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "verified": {
          "description": "Ticked with task-specific evidence.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "without_attestation": {
          "description": "Ticks speccoder committed without an attestation.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "verified",
        "regression_only",
        "ticked_without_evidence",
        "evidence_without_tick",
        "without_attestation",
        "attested",
        "skipped",
        "ready",
        "blocked",
        "stale"
      ],
      "type": "object"
    },
    "StepState": {
      "description": "Where a step of the journey is.",
      "oneOf": [
        {
          "const": "done",
          "description": "Done.",
          "type": "string"
        },
        {
          "const": "now",
          "description": "The one to take now.",
          "type": "string"
        },
        {
          "const": "todo",
          "description": "Later.",
          "type": "string"
        },
        {
          "const": "skipped",
          "description": "Passed without its file: a task list written without a spec or a\nplan. Not a step left to take.",
          "type": "string"
        }
      ]
    },
    "TaskStatus": {
      "description": "One task and its evidence.",
      "properties": {
        "attestation": {
          "description": "For a task speccoder committed: its attestation as the note says,\nsignatures unchecked — `signed <kind> <keyid>`, `unsigned` or\n`missing` (`attest verify` checks them).",
          "type": [
            "string",
            "null"
          ]
        },
        "blocked_by": {
          "description": "Open dependencies of a blocked task.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "bug": {
          "description": "A bug task: the bug's outcome (`awaiting_confirmation`,\n`cannot_reproduce`, `fixed`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "description": "The speccoder commit that ticked it.",
          "type": [
            "string",
            "null"
          ]
        },
        "drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/Drift"
            },
            {
              "type": "null"
            }
          ],
          "description": "What changed in the intent (spec, plan, constitution) since this\ntask's evidence was committed: its tick was judged against an earlier\nversion. `None`: nothing changed, or the task has no commit."
        },
        "id": {
          "description": "Task ID.",
          "type": "string"
        },
        "last_attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastAttempt"
            },
            {
              "type": "null"
            }
          ],
          "description": "For an open task: its latest saved attempt."
        },
        "note": {
          "description": "The reason a person gave for `accept` or `skip`.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "description": "Enclosing phase heading.",
          "type": "string"
        },
        "run_id": {
          "description": "The agentplane run of that attempt.",
          "type": [
            "string",
            "null"
          ]
        },
        "set_aside": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetAside"
            },
            {
              "type": "null"
            }
          ],
          "description": "Changes found in the worktree when the task's run started (a person's\nedits, or an interrupted run's leftovers), saved and set aside."
        },
        "state": {
          "description": "`verified`, `regression_only` (ticked by speccoder with that verdict),\n`attested` (ticked by `speccoder task accept`), `ticked_without_evidence`\n(ticked, no speccoder commit), `evidence_without_tick` (in place: a\nverdict commit names the task, its local tick is missing),\n`skipped`, `ready` or `blocked`.",
          "type": "string"
        },
        "strength": {
          "description": "A verified tick's acceptance strength as its trailer says\n(`0.83 mutants=9/11 near-miss=1/2`, `not measured (…)`).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Title after markers.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "phase",
        "state",
        "attestation",
        "blocked_by",
        "commit",
        "run_id",
        "last_attempt",
        "note"
      ],
      "type": "object"
    },
    "TraceRow": {
      "description": "One row of the requirement → scenario → test → verdict matrix.",
      "properties": {
        "changed": {
          "default": false,
          "description": "The requirement changed since that task's tick: the verdict is for\nits earlier wording.",
          "type": "boolean"
        },
        "requirement": {
          "description": "`FR-001`, `SC-002`.",
          "type": "string"
        },
        "scenario": {
          "description": "`US1.2`: story 1, acceptance scenario 2.",
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "description": "The task that cites it.",
          "type": [
            "string",
            "null"
          ]
        },
        "test": {
          "description": "The acceptance test.",
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "description": "That task's verdict.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "requirement",
        "scenario",
        "test",
        "task",
        "verdict",
        "changed"
      ],
      "type": "object"
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/report.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `speccoder report`: what the branch's history shows.",
  "properties": {
    "artifacts": {
      "default": [],
      "description": "The planning artifacts that exist (`spec`, `plan`, `tasks`).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "branch": {
      "description": "`speccoder/<feature>`, if speccoder has worked on the feature.",
      "type": [
        "string",
        "null"
      ]
    },
    "convergence": {
      "description": "Convergence rounds, oldest first.",
      "items": {
        "$ref": "#/$defs/ConvergenceRound"
      },
      "type": "array"
    },
    "feature": {
      "description": "Feature directory name.",
      "type": "string"
    },
    "issues": {
      "description": "GitHub issue URLs the feature's spec names: where it came from, and\nwhat its pull request closes.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "journey": {
      "default": [],
      "description": "Where the feature is: spec → plan → tasks → commit → run → review.",
      "items": {
        "$ref": "#/$defs/JourneyStep"
      },
      "type": "array"
    },
    "planning": {
      "description": "While the feature has no task list: the planning skills that come\nnext (`plan`, `tasks`); empty once it has one.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewTotals"
        },
        {
          "type": "null"
        }
      ],
      "description": "The person's review of the spec's requirements, when the\nformat has requirement identifiers."
    },
    "selected_by": {
      "default": "",
      "description": "How the feature was chosen (`recorded in .specify/feature.json`,\n`the only feature`, `named with --feature`).",
      "type": "string"
    },
    "source": {
      "description": "Where `tasks.md` was read: `branch` or `checkout`.",
      "type": "string"
    },
    "tasks": {
      "description": "Every task, in document order.",
      "items": {
        "$ref": "#/$defs/TaskStatus"
      },
      "type": "array"
    },
    "totals": {
      "$ref": "#/$defs/StatusTotals",
      "description": "Counts by evidence."
    },
    "trace": {
      "description": "Requirement → task → verdict, in the spec's order; a requirement no\ntask cites is a row without a task.",
      "items": {
        "$ref": "#/$defs/TraceRow"
      },
      "type": "array"
    },
    "uncommitted": {
      "description": "Planning files under the feature's directory not yet committed\n(`speccoder run` reads committed files only).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "unmerged_commits": {
      "description": "Commits on the branch that the checkout's HEAD does not contain.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "feature",
    "branch",
    "source",
    "selected_by",
    "artifacts",
    "journey",
    "unmerged_commits",
    "tasks",
    "convergence",
    "trace",
    "totals",
    "issues"
  ],
  "title": "report: every task and its evidence",
  "type": "object"
}
