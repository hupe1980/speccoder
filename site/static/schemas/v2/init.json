{
  "$defs": {
    "InitCheck": {
      "description": "One detected check.",
      "properties": {
        "argv": {
          "description": "The command.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "`[checks.<name>]`.",
          "type": "string"
        },
        "tier": {
          "description": "`fast` or `full`.",
          "type": "string"
        },
        "why": {
          "description": "Why it was proposed.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "argv",
        "tier",
        "why"
      ],
      "type": "object"
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/init.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `speccoder init`.",
  "properties": {
    "checks": {
      "description": "The checks it declares.",
      "items": {
        "$ref": "#/$defs/InitCheck"
      },
      "type": "array"
    },
    "model": {
      "description": "`provider/model`.",
      "type": "string"
    },
    "path": {
      "description": "The configuration file.",
      "type": "string"
    },
    "wrote": {
      "description": "Files written, relative to the project root.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "path",
    "checks",
    "model",
    "wrote"
  ],
  "title": "init: the configuration written",
  "type": "object"
}
