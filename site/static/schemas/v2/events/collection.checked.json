{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a domain event's public projection: ids, digests and counts",
  "description": "`collection.checked`, as published: paths and states.",
  "type": "object",
  "properties": {
    "task": {
      "description": "The task.",
      "type": "string"
    },
    "files": {
      "description": "Each judged test file.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublicCollectionFile"
      }
    }
  },
  "required": [
    "task",
    "files"
  ],
  "$defs": {
    "PublicCollectionFile": {
      "description": "One file of [`PublicCollectionChecked`].",
      "type": "object",
      "properties": {
        "path": {
          "description": "Workspace-relative path.",
          "type": "string"
        },
        "state": {
          "description": "`collected`, `not_collected`, `unknown`.",
          "$ref": "#/$defs/FileState"
        },
        "decided_by": {
          "description": "`static`, `junit`, `listing`; `null` when unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/DecidedBy"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "state",
        "decided_by"
      ]
    },
    "FileState": {
      "description": "Whether the run collected a test from a file.",
      "oneOf": [
        {
          "description": "At least one test from it ran (passed or failed).",
          "type": "string",
          "const": "collected"
        },
        {
          "description": "None did.",
          "type": "string",
          "const": "not_collected"
        },
        {
          "description": "speccoder cannot tell.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "DecidedBy": {
      "description": "What decided a file's state.",
      "oneOf": [
        {
          "description": "The toolchain's static rule.",
          "type": "string",
          "const": "static"
        },
        {
          "description": "The check's fresh JUnit report.",
          "type": "string",
          "const": "junit"
        },
        {
          "description": "The runner's own listing.",
          "type": "string",
          "const": "listing"
        }
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/events/collection.checked.json"
}
