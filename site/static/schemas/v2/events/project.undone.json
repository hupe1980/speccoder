{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a domain event's public projection: ids, digests and counts",
  "description": "`project.undone`, as published.",
  "type": "object",
  "properties": {
    "path_digest": {
      "description": "SHA-256 of the folder's canonical path.",
      "type": "string"
    },
    "kind": {
      "description": "`trash` or `revert`.",
      "type": "string"
    },
    "via": {
      "description": "Through what.",
      "type": "string"
    }
  },
  "required": [
    "path_digest",
    "kind",
    "via"
  ],
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/events/project.undone.json"
}
