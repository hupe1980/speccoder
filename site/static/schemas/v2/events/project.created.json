{
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/events/project.created.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`project.created`, as published: no path, no idea text.",
  "properties": {
    "commit": {
      "description": "speccoder's commit.",
      "type": "string"
    },
    "format": {
      "description": "The spec format.",
      "type": "string"
    },
    "mode": {
      "description": "`new_folder` or `existing_repository`.",
      "type": "string"
    },
    "path_digest": {
      "description": "SHA-256 of the folder's canonical path.",
      "type": "string"
    },
    "stack": {
      "description": "The stack.",
      "type": "string"
    },
    "via": {
      "description": "Through what.",
      "type": "string"
    }
  },
  "required": [
    "path_digest",
    "mode",
    "stack",
    "format",
    "commit",
    "via"
  ],
  "title": "a domain event's public projection: ids, digests and counts",
  "type": "object"
}
