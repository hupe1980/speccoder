{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature similar: the requirements close to a description, and the terms they share",
  "description": "The `similar` payload: what was compared and what is close.",
  "type": "object",
  "properties": {
    "query": {
      "description": "The description, as given.",
      "type": "string"
    },
    "compared": {
      "description": "How many requirements it was compared with.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "limited": {
      "description": "Whether the corpus was limited to the [`MAX_UNITS`] most recently\nchanged units.",
      "type": "boolean"
    },
    "matches": {
      "description": "The close ones, the closest first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SimilarMatch"
      }
    }
  },
  "required": [
    "query",
    "compared",
    "limited",
    "matches"
  ],
  "$defs": {
    "SimilarMatch": {
      "description": "A requirement close to the description.",
      "type": "object",
      "properties": {
        "unit": {
          "description": "The unit (`003-reports`).",
          "type": "string"
        },
        "requirement": {
          "description": "The requirement's identifier (`FR-004`).",
          "type": "string"
        },
        "text": {
          "description": "The requirement as written.",
          "type": "string"
        },
        "score": {
          "description": "Cosine in [0, 1], rounded to two places.",
          "type": "number",
          "format": "double"
        },
        "level": {
          "description": "`close` or `very_close`.",
          "$ref": "#/$defs/SimilarLevel"
        },
        "shared": {
          "description": "The terms it shares with the description, the weightiest first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "at": {
          "description": "Where it is written.",
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "unit",
        "requirement",
        "text",
        "score",
        "level",
        "shared",
        "at"
      ]
    },
    "SimilarLevel": {
      "description": "How close a match is.",
      "oneOf": [
        {
          "description": "At or above [`CLOSE`].",
          "type": "string",
          "const": "close"
        },
        {
          "description": "At or above [`VERY_CLOSE`].",
          "type": "string",
          "const": "very_close"
        }
      ]
    },
    "Place": {
      "description": "Where a requirement is written.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The document, project-relative.",
          "type": "string"
        },
        "line": {
          "description": "The line, 1-based.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "quote": {
          "description": "That line, verbatim.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "quote"
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/similar.json"
}
