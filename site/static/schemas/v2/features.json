{
  "$defs": {
    "FeatureEntry": {
      "description": "One feature (or change) of the project, as `speccoder feature` lists it.",
      "properties": {
        "artifacts": {
          "description": "Which planning artifacts exist: `spec`, `plan`, `tasks`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "current": {
          "description": "The current one.",
          "type": "boolean"
        },
        "dir": {
          "description": "Repository-relative directory.",
          "type": "string"
        },
        "done": {
          "description": "Ticked tasks.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Directory name, e.g. `001-greet`.",
          "type": "string"
        },
        "number": {
          "description": "1-based position, the number `speccoder feature <n>` takes.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "tasks": {
          "description": "All tasks (0: no task list yet).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "description": "The title its spec (or proposal) gives, when it has one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "number",
        "name",
        "dir",
        "current",
        "done",
        "tasks",
        "artifacts"
      ],
      "type": "object"
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/features.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `speccoder feature`.",
  "properties": {
    "action": {
      "description": "What this call did: `listed`, `switched` or `cleared`.",
      "type": "string"
    },
    "current": {
      "description": "The current one's name.",
      "type": [
        "string",
        "null"
      ]
    },
    "features": {
      "description": "Every feature, in order.",
      "items": {
        "$ref": "#/$defs/FeatureEntry"
      },
      "type": "array"
    },
    "reason": {
      "description": "How it is current: `argument`, `environment`, `recorded`,\n`only_feature` or `none`.",
      "type": "string"
    },
    "reason_text": {
      "description": "The same in words (`recorded in .specify/feature.json`).",
      "type": "string"
    },
    "unit": {
      "description": "`feature` or `change`.",
      "type": "string"
    }
  },
  "required": [
    "unit",
    "current",
    "reason",
    "reason_text",
    "action",
    "features"
  ],
  "title": "feature: the features and which one is current",
  "type": "object"
}
