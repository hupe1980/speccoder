{
  "$defs": {
    "AcceptanceStrength": {
      "description": "The acceptance set's strength, as recorded with a verdict.",
      "properties": {
        "combined": {
          "$ref": "#/$defs/Strength",
          "description": "Visible and held-out together: what the verdict rests on (equal to\n`visible` without held-out tests). Mutants run with the visible\ncommand only, so its mutant counts are a lower bound."
        },
        "duration_ms": {
          "description": "How long the stage took.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "gate": {
          "$ref": "#/$defs/Gate",
          "description": "The gate."
        },
        "held_out": {
          "description": "A held-out set was overlaid.",
          "type": "boolean"
        },
        "mutants": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mutants"
            },
            {
              "type": "null"
            }
          ],
          "description": "The mutants."
        },
        "near_misses": {
          "description": "The near misses.",
          "items": {
            "$ref": "#/$defs/NearMiss"
          },
          "type": "array"
        },
        "notes": {
          "description": "Why not (fully) measured, or what was dropped.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "permitted": {
          "description": "The permitted alternatives.",
          "items": {
            "$ref": "#/$defs/Permitted"
          },
          "type": "array"
        },
        "rulings": {
          "description": "Rulings that applied.",
          "items": {
            "$ref": "#/$defs/Ruling"
          },
          "type": "array"
        },
        "run_id": {
          "description": "The near-miss call's run.",
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "description": "The near-miss call's tokens."
        },
        "visible": {
          "$ref": "#/$defs/Strength",
          "description": "The visible set alone."
        }
      },
      "required": [
        "visible",
        "combined",
        "held_out",
        "near_misses",
        "permitted",
        "gate",
        "duration_ms"
      ],
      "type": "object"
    },
    "CheckResult": {
      "description": "One check run.",
      "properties": {
        "argv": {
          "description": "The command, as run.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "duration_ms": {
          "description": "Wall-clock duration.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exit_code": {
          "description": "Process exit code, if it exited.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "flaky": {
          "default": false,
          "description": "It failed once and passed when run again: named, never trusted as\ntask evidence.",
          "type": "boolean"
        },
        "junit": {
          "description": "Whether the check declares a JUnit report.",
          "type": "boolean"
        },
        "name": {
          "description": "Name from `speccoder.toml`.",
          "type": "string"
        },
        "note": {
          "description": "Why the check was skipped, errored, or has no tests.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/CheckStatus",
          "description": "What happened."
        },
        "stderr_tail": {
          "description": "Last part of stderr (lossy UTF-8).",
          "type": "string"
        },
        "stdout_tail": {
          "description": "Last part of stdout (lossy UTF-8).",
          "type": "string"
        },
        "tests": {
          "description": "Tests from the JUnit report, if one was declared and freshly written.",
          "items": {
            "$ref": "#/$defs/TestResult"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "truncated": {
          "description": "Output exceeded the capture cap.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "argv",
        "status",
        "exit_code",
        "duration_ms",
        "junit",
        "tests",
        "stdout_tail",
        "stderr_tail",
        "truncated",
        "note",
        "flaky"
      ],
      "type": "object"
    },
    "CheckStatus": {
      "description": "Outcome of one check.",
      "oneOf": [
        {
          "const": "passed",
          "description": "Exited 0.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Exited non-zero.",
          "type": "string"
        },
        {
          "const": "timed_out",
          "description": "Killed at its deadline.",
          "type": "string"
        },
        {
          "const": "skipped",
          "description": "Not applicable (its `when_exists` path is absent); not evidence of anything.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Could not be run at all (e.g. command not found).",
          "type": "string"
        }
      ]
    },
    "Comparison": {
      "description": "What changed relative to a baseline (pass-to-pass).",
      "properties": {
        "count_after": {
          "description": "Tests collected now.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "count_before": {
          "description": "Tests collected in the baseline.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failing_as_before": {
          "description": "Checks failing now only because of tests that already failed in the baseline.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "new_tests": {
          "description": "Tests not in the baseline.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pre_existing": {
          "description": "Tests failing in both runs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "regressions": {
          "description": "Tests that passed in the baseline and now fail or are missing.",
          "items": {
            "$ref": "#/$defs/Regression"
          },
          "type": "array"
        }
      },
      "required": [
        "regressions",
        "pre_existing",
        "new_tests",
        "count_before",
        "count_after",
        "failing_as_before"
      ],
      "type": "object"
    },
    "Counts": {
      "description": "Rejected of judged, for one source.",
      "properties": {
        "judged": {
          "description": "Judged (unviable excluded).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rejected": {
          "description": "Rejected (timeouts included).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rejected",
        "judged"
      ],
      "type": "object"
    },
    "Digest": {
      "description": "What the next attempt is told about the previous one.",
      "properties": {
        "attempt": {
          "description": "The attempt this digest describes (1-based).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "checks": {
          "description": "Checks that did not pass.",
          "items": {
            "$ref": "#/$defs/FailedCheck"
          },
          "type": "array"
        },
        "discarded": {
          "description": "Paths the previous attempt changed; its changes were discarded.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reasons": {
          "description": "The verdict's reasons.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "attempt",
        "reasons",
        "checks",
        "discarded"
      ],
      "type": "object"
    },
    "EarlierAttempt": {
      "description": "A failed attempt that was undone and retried.",
      "properties": {
        "attempt_status": {
          "description": "The attempt's status.",
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest",
          "description": "What the next attempt was told."
        },
        "fingerprint": {
          "description": "The failure's fingerprint.",
          "type": "string"
        },
        "run_id": {
          "description": "The agentplane run of the attempt.",
          "type": "string"
        },
        "usage": {
          "description": "Token usage of the attempt."
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verdict"
            },
            {
              "type": "null"
            }
          ],
          "description": "The verifier's verdict."
        }
      },
      "required": [
        "run_id",
        "attempt_status",
        "verdict",
        "fingerprint",
        "digest",
        "usage"
      ],
      "type": "object"
    },
    "FailedCheck": {
      "description": "One check that did not pass.",
      "properties": {
        "argv": {
          "description": "The command, as run.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "excerpt": {
          "description": "Output from the first error line on, capped.",
          "type": "string"
        },
        "failing_tests": {
          "description": "Failing test IDs, when the check reports tests.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "Name from `speccoder.toml` (or `acceptance`).",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus",
          "description": "What happened."
        }
      },
      "required": [
        "name",
        "argv",
        "status",
        "failing_tests",
        "excerpt"
      ],
      "type": "object"
    },
    "Gate": {
      "description": "The `min_strength` gate.",
      "oneOf": [
        {
          "const": "off",
          "description": "No `min_strength`.",
          "type": "string"
        },
        {
          "const": "met",
          "description": "Met at once.",
          "type": "string"
        },
        {
          "const": "regenerated_met",
          "description": "Met after one regeneration of the acceptance tests.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Not met, or not measurable.",
          "type": "string"
        }
      ]
    },
    "InstructionFile": {
      "description": "A repository instructions file given to an attempt.",
      "properties": {
        "bytes": {
          "description": "Its size.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "cut": {
          "description": "Cut to fit the instructions budget.",
          "type": "boolean"
        },
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        },
        "sha256": {
          "description": "sha256 of the file.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "cut"
      ],
      "type": "object"
    },
    "Mutants": {
      "description": "Mutants of the changed code, run against the acceptance command only.",
      "properties": {
        "caught": {
          "description": "Caught by an assertion.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "missed": {
          "description": "Not caught.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "survivors": {
          "description": "The missed ones, as the tool names them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timeout": {
          "description": "Caught by the deadline.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "tool": {
          "description": "The tool.",
          "type": "string"
        },
        "unviable": {
          "description": "Did not build.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tool",
        "caught",
        "missed",
        "timeout",
        "unviable",
        "survivors"
      ],
      "type": "object"
    },
    "NearMiss": {
      "description": "A model-written near miss: plausible, and wrong about one scenario.",
      "properties": {
        "combined": {
          "$ref": "#/$defs/Outcome",
          "description": "Against the visible and the held-out set together."
        },
        "id": {
          "description": "`near-miss-1`, …",
          "type": "string"
        },
        "rationale": {
          "description": "What it gets wrong, in one line (the author's claim).",
          "type": "string"
        },
        "scenario": {
          "description": "The scenario or requirement it gets wrong.",
          "type": "string"
        },
        "visible": {
          "$ref": "#/$defs/Outcome",
          "description": "Against the visible set."
        }
      },
      "required": [
        "id",
        "scenario",
        "rationale",
        "visible",
        "combined"
      ],
      "type": "object"
    },
    "Outcome": {
      "description": "What a candidate run showed.",
      "oneOf": [
        {
          "const": "rejected",
          "description": "The acceptance run failed on an assertion (or a symbol it needs is gone).",
          "type": "string"
        },
        {
          "const": "survived",
          "description": "The acceptance run passed: the set accepts this wrong implementation.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "The run hit its deadline: a detectable failure, counted as rejected.",
          "type": "string"
        },
        {
          "const": "unviable",
          "description": "It did not build or the tests could not be collected: not judged.",
          "type": "string"
        }
      ]
    },
    "Permitted": {
      "description": "An alternative the author says the spec allows.",
      "properties": {
        "digest": {
          "description": "`sha256:<hex>` of its files: what a ruling is bound to.",
          "type": "string"
        },
        "failing": {
          "description": "The failing run's last lines, when rejected.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "`permitted-1`, …",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/PermittedOutcome",
          "description": "Against the visible and held-out set together."
        },
        "patch": {
          "description": "Where its patch is kept for a person.",
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "description": "The freedom it uses (the author's claim).",
          "type": "string"
        },
        "scenario": {
          "description": "The scenario whose open choice it takes differently.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scenario",
        "rationale",
        "digest",
        "outcome"
      ],
      "type": "object"
    },
    "PermittedOutcome": {
      "description": "What a spec-permitted alternative showed.",
      "oneOf": [
        {
          "const": "accepted",
          "description": "The set accepts it, as it should.",
          "type": "string"
        },
        {
          "const": "rejected",
          "description": "The set rejects it on an assertion: probably over-strict.",
          "type": "string"
        },
        {
          "const": "ruled",
          "description": "Rejected, and a person ruled the tests right.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "Timed out: no finding (a hang is not an assertion).",
          "type": "string"
        },
        {
          "const": "unviable",
          "description": "Did not build: no finding.",
          "type": "string"
        }
      ]
    },
    "Regression": {
      "description": "A test that passed in the baseline and no longer does.",
      "properties": {
        "id": {
          "description": "`check/test`.",
          "type": "string"
        },
        "now": {
          "description": "`failed`, `skipped`, or `missing`.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "now"
      ],
      "type": "object"
    },
    "Ruling": {
      "description": "A person's ruling that an over-strict finding was wrong: the tests were\nright, the alternative is not what the spec allows (D-074).",
      "properties": {
        "by": {
          "description": "Who ruled.",
          "type": "string"
        },
        "digest": {
          "description": "The alternative's digest.",
          "type": "string"
        },
        "reason": {
          "description": "Why.",
          "type": "string"
        },
        "scenario": {
          "description": "Its scenario.",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "scenario",
        "by",
        "reason"
      ],
      "type": "object"
    },
    "ScopeFinding": {
      "description": "What an attempt changed beyond the paths its task names.",
      "properties": {
        "named": {
          "description": "The paths the task names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outside": {
          "description": "Changed paths outside them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stated": {
          "description": "The task names at least one path.",
          "type": "boolean"
        }
      },
      "required": [
        "stated",
        "named",
        "outside"
      ],
      "type": "object"
    },
    "State": {
      "description": "How far a measurement got.",
      "oneOf": [
        {
          "const": "measured",
          "description": "Everything planned was run.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "The budget ran out: what ran is recorded.",
          "type": "string"
        },
        {
          "const": "not_measured",
          "description": "Nothing could be judged (no tool, no variant, an error).",
          "type": "string"
        },
        {
          "const": "not_applicable",
          "description": "The change touches no source file.",
          "type": "string"
        }
      ]
    },
    "Strength": {
      "description": "One set's strength.",
      "properties": {
        "mutants": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counts"
            },
            {
              "type": "null"
            }
          ],
          "description": "Mutants; `None` when not run."
        },
        "near_misses": {
          "$ref": "#/$defs/Counts",
          "description": "Near misses."
        },
        "share": {
          "description": "Rejected / judged over every source; `None` when nothing was judged.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/State",
          "description": "How far it got."
        },
        "survivors": {
          "description": "What got through: mutant names and near-miss ids with their scenario.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unviable": {
          "description": "Candidates that did not build.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "state",
        "share",
        "mutants",
        "near_misses",
        "unviable",
        "survivors"
      ],
      "type": "object"
    },
    "TestOutcome": {
      "description": "Outcome of one test from a JUnit report.",
      "oneOf": [
        {
          "const": "passed",
          "description": "Passed.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Failed (an assertion, a `<failure>` in JUnit).",
          "type": "string"
        },
        {
          "const": "skipped",
          "description": "Skipped or ignored.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Errored before or outside an assertion (a `<error>` in JUnit: setup,\ncollection, an unexpected exception).",
          "type": "string"
        }
      ]
    },
    "TestResult": {
      "description": "One test.",
      "properties": {
        "id": {
          "description": "`classname::name`, or `name` when there is no class.",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/TestOutcome",
          "description": "What happened."
        }
      },
      "required": [
        "id",
        "outcome"
      ],
      "type": "object"
    },
    "Verdict": {
      "description": "How strong the evidence for a task is.",
      "oneOf": [
        {
          "description": "A task-specific check produced evidence, nothing failed, nothing regressed.",
          "properties": {
            "verdict": {
              "const": "verified",
              "type": "string"
            }
          },
          "required": [
            "verdict"
          ],
          "type": "object"
        },
        {
          "description": "Nothing failed or regressed, but nothing task-specific was established.",
          "properties": {
            "verdict": {
              "const": "regression_only",
              "type": "string"
            }
          },
          "required": [
            "verdict"
          ],
          "type": "object"
        },
        {
          "description": "Something failed or regressed.",
          "properties": {
            "reasons": {
              "description": "One line per reason.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "verdict": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "reasons"
          ],
          "type": "object"
        }
      ]
    },
    "VerifyReport": {
      "description": "Everything one `verify` run established.",
      "properties": {
        "checks": {
          "description": "One result per configured check, in configuration order.",
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "type": "array"
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/Comparison"
            },
            {
              "type": "null"
            }
          ],
          "description": "Comparison with a baseline, if one was given."
        },
        "passed": {
          "description": "Whether verification passed (see [`passes`]).",
          "type": "boolean"
        },
        "root": {
          "description": "Project root the checks ran in.",
          "type": "string"
        },
        "tier": {
          "description": "`fast` or `full`.",
          "type": "string"
        }
      },
      "required": [
        "root",
        "tier",
        "checks",
        "comparison",
        "passed"
      ],
      "type": "object"
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/run.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `speccoder run`.",
  "properties": {
    "acceptance": {
      "description": "Spec-derived acceptance tests: files, command, red/green, notes."
    },
    "attempt_status": {
      "description": "`completed`, `blocked`, `needs_approval`, `budget_exhausted` or `failed`.",
      "type": "string"
    },
    "attestation": {
      "description": "What the tick's attestation came to: `{ state: signed | unsigned |\nmissing, signer, reason }` (F-061)."
    },
    "changes": {
      "description": "Paths changed between the checkpoints: `added` / `modified` / `deleted`.",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "commit": {
      "description": "The commit on `speccoder/<feature>` holding the attempt and the tick.",
      "type": [
        "string",
        "null"
      ]
    },
    "earlier": {
      "description": "Earlier attempts at this task in this run, discarded and retried.",
      "items": {
        "$ref": "#/$defs/EarlierAttempt"
