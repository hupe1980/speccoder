{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "converge: the convergence round",
  "description": "Result of `speccoder converge`.",
  "type": "object",
  "properties": {
    "feature": {
      "description": "Feature directory name.",
      "type": "string"
    },
    "run_id": {
      "description": "The agentplane run of the assessment, if one ran.",
      "type": [
        "string",
        "null"
      ]
    },
    "round": {
      "description": "This round's number (1 = the first Convergence phase).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "outcome": {
      "description": "`converged`, `tasks_appended`, `needs_review` (only unrequested\nfindings), `no_progress`, `round_limit` or `failed`.",
      "type": "string"
    },
    "findings": {
      "description": "Every finding as the model reported it (its claim, not evidence).",
      "type": "array",
      "items": true
    },
    "appended": {
      "description": "Tasks speccoder appended, as `T0NN text`.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unrequested": {
      "description": "`unrequested` findings: for a person, never turned into tasks.",
      "type": "array",
      "items": true
    },
    "repeated": {
      "description": "Findings that repeat an earlier convergence task: no progress.",
      "type": "array",
      "items": true
    },
    "commit": {
      "description": "The commit on `speccoder/<feature>` holding the appended section.",
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "description": "Token usage of the assessment."
    },
    "tool_calls": {
      "description": "Every tool call with the policy's decision.",
      "type": "array",
      "items": true
    },
    "hooks": {
      "description": "Extension hooks run, offered or skipped around it.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "feature",
    "run_id",
    "round",
    "outcome",
    "findings",
    "appended",
    "unrequested",
    "repeated",
    "commit",
    "usage",
    "tool_calls",
    "hooks"
  ],
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/converge.json"
}
