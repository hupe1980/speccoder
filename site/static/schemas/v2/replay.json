{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "replay: the replayed run",
  "description": "Result of `speccoder replay`.",
  "type": "object",
  "properties": {
    "run_id": {
      "description": "The replayed run.",
      "type": "string"
    },
    "result": {
      "description": "`reproduced`, `diverged` or `not_found`.",
      "type": "string"
    },
    "detail": {
      "description": "What the replay said.",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "result",
    "detail"
  ],
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/replay.json"
}
