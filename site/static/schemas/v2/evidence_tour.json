{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attest tour, /api/tour: one task's evidence, step by step",
  "description": "Result of `speccoder attest tour` and `/api/tour`: one task's tour.",
  "type": "object",
  "properties": {
    "feature": {
      "description": "The unit.",
      "type": "string"
    },
    "task": {
      "description": "Task ID.",
      "type": "string"
    },
    "title": {
      "description": "The task's title.",
      "type": "string"
    },
    "verdict": {
      "description": "The verdict the evidence claims, when any.",
      "type": [
        "string",
        "null"
      ]
    },
    "commit": {
      "description": "The task commit, when one carries the task's evidence.",
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "description": "The six steps, in order — only the first for an unverifiable tick.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TourStep"
      }
    },
    "unverifiable": {
      "description": "For an unverifiable tick: why the evidence does not count.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "feature",
    "task",
    "title",
    "verdict",
    "commit",
    "steps",
    "unverifiable"
  ],
  "$defs": {
    "TourStep": {
      "description": "One step.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Which.",
          "$ref": "#/$defs/StepKind"
        },
        "source": {
          "description": "Where it comes from.",
          "$ref": "#/$defs/Source"
        },
        "title": {
          "description": "Its title (`Requirement`, `Frozen tests`, …).",
          "type": "string"
        },
        "body_markdown": {
          "description": "What it shows, Markdown: a first line, then optional block lines.",
          "type": "string"
        },
        "facts": {
          "description": "The facts shown, as data (names, counts, digests)."
        }
      },
      "required": [
        "kind",
        "source",
        "title",
        "body_markdown",
        "facts"
      ]
    },
    "StepKind": {
      "description": "A step of the tour, in its order.",
      "oneOf": [
        {
          "description": "The requirement passage the task cites, as the tick's commit has it.",
          "type": "string",
          "const": "requirement"
        },
        {
          "description": "The acceptance tests frozen before the attempt.",
          "type": "string",
          "const": "frozen_tests"
        },
        {
          "description": "The tests failing first, and how.",
          "type": "string",
          "const": "red"
        },
        {
          "description": "The task commit's diff.",
          "type": "string",
          "const": "diff"
        },
        {
          "description": "What passed after: acceptance, held-out, the regression checks.",
          "type": "string",
          "const": "green"
        },
        {
          "description": "How well the tests tell right from wrong.",
          "type": "string",
          "const": "strength"
        }
      ]
    },
    "Source": {
      "description": "Where a step's content comes from.",
      "oneOf": [
        {
          "description": "A signed statement says it (and what is shown hashes to it).",
          "type": "string",
          "const": "signed"
        },
        {
          "description": "The commit holds it (git objects, not a signature).",
          "type": "string",
          "const": "committed"
        },
        {
          "description": "Nothing recorded it.",
          "type": "string",
          "const": "not_recorded"
        }
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/evidence_tour.json"
}
