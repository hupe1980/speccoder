{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bench import: the imported cases",
  "description": "Result of `speccoder bench import`.",
  "type": "object",
  "properties": {
    "out": {
      "description": "The suite directory written.",
      "type": "string"
    },
    "imported": {
      "description": "Instances turned into cases.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "description": "Instances not imported, with why.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "out",
    "imported",
    "skipped"
  ],
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/bench.json"
}
