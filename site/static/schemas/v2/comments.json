{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review comments: the comment tray and the last revision turn",
  "description": "Result of `speccoder review comments`: the tray and the last turn.",
  "type": "object",
  "properties": {
    "feature": {
      "description": "The feature.",
      "type": "string"
    },
    "drafts": {
      "description": "Every draft not yet sent, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommentDraft"
      }
    },
    "turn": {
      "description": "The last revision turn.",
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionView"
        },
        {
          "type": "null"
        }
      ]
    },
    "revise_with": {
      "description": "The skill a send runs (`speckit-clarify`), when the format has one.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "feature",
    "drafts",
    "turn",
    "revise_with"
  ],
  "$defs": {
    "CommentDraft": {
      "description": "One comment in the tray.",
      "type": "object",
      "properties": {
        "id": {
          "description": "`c1`, `c2`, …",
          "type": "string"
        },
        "anchor": {
          "description": "What it is about.",
          "$ref": "#/$defs/CommentAnchor"
        },
        "text": {
          "description": "The person's words.",
          "type": "string"
        },
        "by": {
          "description": "Who.",
          "type": "string"
        },
        "at": {
          "description": "Unix seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "description": "Where it is.",
          "$ref": "#/$defs/DraftState"
        },
        "kept": {
          "description": "The person kept it although its quote moved.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "id",
        "anchor",
        "text",
        "by",
        "at",
        "state",
        "kept"
      ]
    },
    "CommentAnchor": {
      "description": "What an anchored comment points at.",
      "oneOf": [
        {
          "description": "A passage of a feature document.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "passage"
            },
            "path": {
              "description": "Project-relative path.",
              "type": "string"
            },
            "start_line": {
              "description": "First line (1-based).",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "end_line": {
              "description": "Last line.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "quote": {
              "description": "The words selected.",
              "type": "string"
            },
            "quote_sha256": {
              "description": "`sha256:<hex>` of the quote (filled when the draft is stored).",
              "type": "string",
              "default": ""
            },
            "section": {
              "description": "Its section's heading path (`Requirements › Functional`).",
              "type": "string",
              "default": ""
            }
          },
          "required": [
            "kind",
            "path",
            "start_line",
            "end_line",
            "quote",
            "quote_sha256",
            "section"
          ]
        },
        {
          "description": "A line of the spec's changes since the last commit.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "diff_line"
            },
            "path": {
              "description": "Project-relative path.",
              "type": "string"
            },
            "side": {
              "description": "`old` or `new`.",
              "type": "string"
            },
            "line": {
              "description": "The line (1-based) on that side.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "quote": {
              "description": "The line's text.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "side",
            "line",
            "quote"
          ]
        },
        {
          "description": "A line of a shown visible test.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "test_line"
            },
            "req": {
              "description": "The requirement.",
              "type": "string"
            },
            "path": {
              "description": "The test's path.",
              "type": "string"
            },
            "line": {
              "description": "The line (1-based).",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "quote": {
              "description": "The line's text.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "req",
            "path",
            "line",
            "quote"
          ]
        },
        {
          "description": "A finding the review shows.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "finding"
            },
            "source": {
              "description": "`analyze` or `review`.",
              "type": "string"
            },
            "id": {
              "description": "Its id.",
              "type": "string"
            },
            "text": {
              "description": "Its text.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source",
            "id",
            "text"
          ]
        }
      ]
    },
    "DraftState": {
      "description": "Where a draft comment is.",
      "oneOf": [
        {
          "description": "In the tray.",
          "type": "string",
          "const": "draft"
        },
        {
          "description": "Its quote is no longer where it was anchored: sent only if kept.",
          "type": "string",
          "const": "outdated"
        },
        {
          "description": "Sent in a revision turn.",
          "type": "string",
          "const": "sent"
        }
      ]
    },
    "RevisionView": {
      "description": "What a revision turn did.",
      "type": "object",
      "properties": {
        "id": {
          "description": "`t1`, `t2`, …",
          "type": "string"
        },
        "comments": {
          "description": "The comments it was sent with.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sections": {
          "description": "The sections they touch.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skill": {
          "description": "The format's revising skill.",
          "type": "string"
        },
        "changed": {
          "description": "Sections it changed.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outside": {
          "description": "Of those, the ones no comment touched.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "description": "`pending` (the person keeps or undoes it), `kept`, `undone`.",
          "type": "string"
        },
        "files": {
          "description": "Files it changed (project-relative).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asked_again": {
          "description": "Requirements whose tests were asked again from test comments.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "beside": {
          "description": "Documents changed while it ran by something other than the skill\n(the person's own edit): *Undo Revision* never overwrites them.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "diffs": {
          "description": "While it waits to be kept or undone: each changed section, before\nand after, for the word diff.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectionDiff"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "comments",
        "sections",
        "skill",
        "changed",
        "outside",
        "outcome",
        "files",
        "asked_again",
        "beside",
        "diffs"
      ]
    },
    "SectionDiff": {
      "description": "One section a revision changed, before and after (each cut to 4000\ncharacters).",
      "type": "object",
      "properties": {
        "path": {
          "description": "The document (project-relative).",
          "type": "string"
        },
        "heading": {
          "description": "Its heading path (`Spec › Requirements`; empty before the first).",
          "type": "string"
        },
        "before": {
          "description": "The section's text before the revision (empty: it was added).",
          "type": "string"
        },
        "after": {
          "description": "After it (empty: it was removed).",
          "type": "string"
        },
        "outside": {
          "description": "No comment touched it.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "heading",
        "before",
        "after",
        "outside"
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/comments.json"
}
