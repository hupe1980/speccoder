{
  "$defs": {
    "IssueEntry": {
      "description": "One open issue.",
      "properties": {
        "assignees": {
          "description": "Who it is assigned to (logins).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "feature": {
          "description": "The feature whose spec names this issue, when one does.",
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "description": "Label names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mine": {
          "description": "Assigned to the person speccoder is signed in as.",
          "type": "boolean"
        },
        "number": {
          "description": "`#n`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "description": "Its title.",
          "type": "string"
        },
        "updated": {
          "description": "Last update, ISO 8601.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Its address.",
          "type": "string"
        }
      },
      "required": [
        "number",
        "title",
        "url",
        "labels",
        "assignees",
        "mine",
        "updated",
        "feature"
      ],
      "type": "object"
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/issues.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `speccoder issue`: the repository's open GitHub issues, read\nthrough GitHub's API as the person.",
  "properties": {
    "issues": {
      "description": "Open issues: assigned to the person first, then the most recently\nupdated.",
      "items": {
        "$ref": "#/$defs/IssueEntry"
      },
      "type": "array"
    },
    "repo": {
      "description": "`owner/name`.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "repo",
    "issues"
  ],
  "title": "issue: the repository's open GitHub issues",
  "type": "object"
}
