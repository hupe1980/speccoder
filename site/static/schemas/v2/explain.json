{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "explain: code entries",
  "description": "Result of `speccoder explain`.",
  "type": "object",
  "properties": {
    "codes": {
      "description": "The code asked for, or every code with `--list`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CodeInfo"
      }
    }
  },
  "required": [
    "codes"
  ],
  "$defs": {
    "CodeInfo": {
      "description": "One code, as `explain` shows it.",
      "type": "object",
      "properties": {
        "code": {
          "description": "`NEEDS-APPROVAL`.",
          "type": "string"
        },
        "kind": {
          "description": "Error, stop or warning.",
          "$ref": "#/$defs/Kind"
        },
        "status": {
          "description": "The status results with this code have.",
          "$ref": "#/$defs/CommandStatus"
        },
        "exit_code": {
          "description": "Its exit code.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "title": {
          "description": "One line.",
          "type": "string"
        },
        "explain": {
          "description": "What it means and why it happens.",
          "type": "string"
        },
        "fix": {
          "description": "How to resolve it (templates: `<task>`, `<feature>` are blanks).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "description": "Its section on the codes page.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "kind",
        "status",
        "exit_code",
        "title",
        "explain",
        "fix",
        "docs"
      ]
    },
    "Kind": {
      "description": "How a code presents itself.",
      "oneOf": [
        {
          "description": "Something failed: `error[CODE]`.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "The run waits for a person: `stopped[CODE]`.",
          "type": "string",
          "const": "stop"
        },
        {
          "description": "It worked, with less than the full evidence: `warning[CODE]`.",
          "type": "string",
          "const": "warning"
        }
      ]
    },
    "CommandStatus": {
      "description": "Outcome class of a command.",
      "oneOf": [
        {
          "description": "The command succeeded.",
          "type": "string",
          "const": "ok"
        },
        {
          "description": "The arguments were invalid.",
          "type": "string",
          "const": "usage_error"
        },
        {
          "description": "An unexpected internal failure.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "No Spec Kit project was found.",
          "type": "string",
          "const": "not_a_project"
        },
        {
          "description": "The result contains error diagnostics.",
          "type": "string",
          "const": "diagnostics_error"
        },
        {
          "description": "No feature could be selected.",
          "type": "string",
          "const": "selection_needed"
        },
        {
          "description": "`speccoder.toml` is missing or invalid, or nothing applies.",
          "type": "string",
          "const": "config_error"
        },
        {
          "description": "A check failed or a test regressed.",
          "type": "string",
          "const": "verification_failed"
        },
        {
          "description": "A git precondition does not hold.",
          "type": "string",
          "const": "git_precondition"
        },
        {
          "description": "No such task or run.",
          "type": "string",
          "const": "not_found"
        },
        {
          "description": "The model call or the run failed.",
          "type": "string",
          "const": "run_failed"
        },
        {
          "description": "Strict replay did not reproduce the recorded run.",
          "type": "string",
          "const": "replay_diverged"
        },
        {
          "description": "The task is done or blocked by open dependencies.",
          "type": "string",
          "const": "task_not_ready"
        },
        {
          "description": "The attempt stopped for a person.",
          "type": "string",
          "const": "needs_human"
        },
        {
          "description": "An evaluation found a false completion or a cheat.",
          "type": "string",
          "const": "eval_failed"
        },
        {
          "description": "The recorded run cannot be re-derived by this build.",
          "type": "string",
          "const": "not_replayable"
        },
        {
          "description": "An attestation is missing, unsigned where required, or does not hold.",
          "type": "string",
          "const": "attestation_failed"
        }
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/explain.json"
}
