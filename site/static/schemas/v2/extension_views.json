{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extension_views: the views extensions place on a feature or the project, with their results",
  "description": "The views placed on a feature (or the project).",
  "type": "object",
  "properties": {
    "views": {
      "description": "Every view, by extension then name.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ViewShown"
      }
    }
  },
  "required": [
    "views"
  ],
  "$defs": {
    "ViewShown": {
      "description": "One view as the app shows it.",
      "type": "object",
      "properties": {
        "extension": {
          "description": "The extension.",
          "type": "string"
        },
        "view": {
          "description": "The view.",
          "$ref": "#/$defs/ViewDef"
        },
        "result": {
          "description": "Its result for the current inputs; none while it waits for trust.",
          "anyOf": [
            {
              "$ref": "#/$defs/ViewResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "waits_for_trust": {
          "description": "The extension waits for trust (or changed since).",
          "type": "boolean"
        }
      },
      "required": [
        "extension",
        "view",
        "waits_for_trust"
      ]
    },
    "ViewDef": {
      "description": "One `[views.<name>]`.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The table's name.",
          "type": "string"
        },
        "title": {
          "description": "Its heading.",
          "type": "string"
        },
        "source": {
          "description": "Its data.",
          "$ref": "#/$defs/ViewSource"
        },
        "widget": {
          "description": "How it shows.",
          "$ref": "#/$defs/ViewWidget"
        },
        "path": {
          "description": "A dotted path into JSON output.",
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "description": "A table's columns.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "place": {
          "description": "Where it stands.",
          "$ref": "#/$defs/ViewPlace"
        },
        "timeout": {
          "description": "Seconds a command may run.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "exit": {
          "description": "Exit codes whose output is still data.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "required": [
        "name",
        "title",
        "source",
        "widget",
        "place",
        "timeout",
        "exit"
      ]
    },
    "ViewSource": {
      "description": "Where a view's data comes from.",
      "oneOf": [
        {
          "description": "A command, run in the sandbox.",
          "type": "object",
          "properties": {
            "run": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        {
          "description": "A file, read as it is.",
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ViewWidget": {
      "description": "How a view shows its data.",
      "oneOf": [
        {
          "description": "SARIF findings.",
          "type": "string",
          "const": "findings"
        },
        {
          "description": "Rows with columns.",
          "type": "string",
          "const": "table"
        },
        {
          "description": "Named numbers or short words.",
          "type": "string",
          "const": "metrics"
        },
        {
          "description": "A document.",
          "type": "string",
          "const": "markdown"
        }
      ]
    },
    "ViewPlace": {
      "description": "Where a view stands.",
      "oneOf": [
        {
          "description": "On each feature's page, about that feature.",
          "type": "string",
          "const": "feature"
        },
        {
          "description": "On the project's overview.",
          "type": "string",
          "const": "project"
        }
      ]
    },
    "ViewResult": {
      "description": "A view's last result.",
      "type": "object",
      "properties": {
        "inputs": {
          "description": "The digest of what it read.",
          "type": "string"
        },
        "ran_at": {
          "description": "When it ran (RFC 3339).",
          "type": "string"
        },
        "duration_ms": {
          "description": "How long.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "data": {
          "description": "Its data.",
          "anyOf": [
            {
              "$ref": "#/$defs/ViewData"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "description": "Why there is no data, in words.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "inputs",
        "ran_at",
        "duration_ms"
      ]
    },
    "ViewData": {
      "description": "A view's data, ready for its widget.",
      "oneOf": [
        {
          "description": "Findings.",
          "type": "object",
          "properties": {
            "widget": {
              "type": "string",
              "const": "findings"
            },
            "findings": {
              "description": "Each finding.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/SarifFinding"
              }
            }
          },
          "required": [
            "widget",
            "findings"
          ]
        },
        {
          "description": "Rows.",
          "type": "object",
          "properties": {
            "widget": {
              "type": "string",
              "const": "table"
            },
            "columns": {
              "description": "The columns.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "description": "Each row's cells, as text.",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "widget",
            "columns",
            "rows"
          ]
        },
        {
          "description": "Named values.",
          "type": "object",
          "properties": {
            "widget": {
              "type": "string",
              "const": "metrics"
            },
            "metrics": {
              "description": "`(name, value)`, values as text.",
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "widget",
            "metrics"
          ]
        },
        {
          "description": "A document, rendered (raw HTML shown as text).",
          "type": "object",
          "properties": {
            "widget": {
              "type": "string",
              "const": "markdown"
            },
            "html": {
              "description": "The HTML.",
              "type": "string"
            }
          },
          "required": [
            "widget",
            "html"
          ]
        }
      ]
    },
    "SarifFinding": {
      "description": "One finding, as speccoder shows it.",
      "type": "object",
      "properties": {
        "rule": {
          "description": "The rule's id.",
          "type": "string"
        },
        "level": {
          "description": "`error`, `warning`, `note` or `none`.",
          "type": "string"
        },
        "message": {
          "description": "What it says.",
          "type": "string"
        },
        "file": {
          "description": "The file, relative to the project.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "The line.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "rule",
        "level",
        "message"
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/extension_views.json"
}
