{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pr: the draft pull request",
  "description": "Result of `speccoder pr`: a draft pull request with the evidence.",
  "type": "object",
  "properties": {
    "feature": {
      "description": "Feature directory name.",
      "type": "string"
    },
    "branch": {
      "description": "`speccoder/<feature>`.",
      "type": "string"
    },
    "base": {
      "description": "The branch the pull request targets.",
      "type": "string"
    },
    "remote": {
      "description": "The git remote pushed to.",
      "type": "string"
    },
    "title": {
      "description": "Pull request title.",
      "type": "string"
    },
    "body": {
      "description": "Pull request body (Markdown): every task's evidence.",
      "type": "string"
    },
    "commands": {
      "description": "What runs (or would run), in order.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opened": {
      "description": "Whether the branch was pushed and the draft opened (`false`: a dry run).",
      "type": "boolean"
    },
    "url": {
      "description": "The pull request, when opened.",
      "type": [
        "string",
        "null"
      ]
    },
    "held_out_ref": {
      "description": "The unit's held-out ref pushed with the branch\n(`refs/speccoder/held-out/<unit>`), when a closed task names a set.",
      "type": [
        "string",
        "null"
      ]
    },
    "held_out_tasks": {
      "description": "The tasks closed on the pushed head whose held-out sets it carries.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "held_out_withheld": {
      "description": "Held-out sets of open tasks: they stay local.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "evidence_check": {
      "description": "`present`: a workflow under `.github/workflows/` runs\n`speccoder attest verify --branch`; `absent`: none does.",
      "type": "string"
    },
    "gates": {
      "description": "The gates that stood before the push (spec 095).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/GateRecord"
      }
    },
    "done": {
      "description": "The definition of done on the branch, CI aside (it runs after the\npush).",
      "anyOf": [
        {
          "$ref": "#/$defs/DoneReport"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "feature",
    "branch",
    "base",
    "remote",
    "title",
    "body",
    "commands",
    "opened",
    "url",
    "held_out_ref",
    "held_out_tasks",
    "held_out_withheld",
    "evidence_check"
  ],
  "$defs": {
    "GateRecord": {
      "description": "One gate's run at its point, as a report and the evidence carry it.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The hook's name.",
          "type": "string"
        },
        "point": {
          "description": "Where it stood.",
          "$ref": "#/$defs/Point"
        },
        "outcome": {
          "description": "How it ended.",
          "$ref": "#/$defs/GateState"
        },
        "reason": {
          "description": "Why it blocked.",
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "description": "`HOOK-BLOCKED`, or `HOOK-UNTRUSTED` for a gate that waits for trust.",
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "description": "How long it ran.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "findings": {
          "description": "The findings it left (SARIF), as shown.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SarifFinding"
          }
        }
      },
      "required": [
        "name",
        "point",
        "outcome",
        "duration_ms"
      ]
    },
    "Point": {
      "description": "Where a gate stands.",
      "oneOf": [
        {
          "description": "After the verdict, before the tick commit.",
          "type": "string",
          "const": "tick"
        },
        {
          "description": "After the person confirms a pull request, before anything is pushed.",
          "type": "string",
          "const": "pr"
        }
      ]
    },
    "GateState": {
      "description": "How one gate ended at its point.",
      "oneOf": [
        {
          "description": "It exited 0.",
          "type": "string",
          "const": "passed"
        },
        {
          "description": "It stopped the point.",
          "type": "string",
          "const": "blocked"
        },
        {
          "description": "An earlier gate at the point blocked first.",
          "type": "string",
          "const": "not_run"
        }
      ]
    },
    "SarifFinding": {
      "description": "One finding, as speccoder shows it.",
      "type": "object",
      "properties": {
        "rule": {
          "description": "The rule's id.",
          "type": "string"
        },
        "level": {
          "description": "`error`, `warning`, `note` or `none`.",
          "type": "string"
        },
        "message": {
          "description": "What it says.",
          "type": "string"
        },
        "file": {
          "description": "The file, relative to the project.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "The line.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "rule",
        "level",
        "message"
      ]
    },
    "DoneReport": {
      "description": "Result of `speccoder done`.",
      "type": "object",
      "properties": {
        "base": {
          "description": "What it compared with: a branch, tag or commit; none found.",
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "description": "One line per part with something to judge, in [`DonePart`] order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DoneLine"
          }
        },
        "done": {
          "description": "No line is not done.",
          "type": "boolean"
        }
      },
      "required": [
        "base",
        "lines",
        "done"
      ]
    },
    "DoneLine": {
      "description": "One part of the definition of done.",
      "type": "object",
      "properties": {
        "part": {
          "description": "Which part.",
          "$ref": "#/$defs/DonePart"
        },
        "state": {
          "description": "How it stands.",
          "$ref": "#/$defs/DoneState"
        },
        "summary": {
          "description": "What it saw, in one line.",
          "type": "string"
        },
        "findings": {
          "description": "The first findings.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DoneFinding"
          }
        },
        "more": {
          "description": "Findings beyond those shown.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "fixes": {
          "description": "What to do, commands as typed.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "part",
        "state",
        "summary"
      ]
    },
    "DonePart": {
      "description": "A part of the definition of done, in the order they are shown.",
      "oneOf": [
        {
          "description": "`[Unreleased]` has an entry when something user-facing changed.",
          "type": "string",
          "const": "changelog"
        },
        {
          "description": "Every relative and site-internal link in the docs resolves.",
          "type": "string",
          "const": "links"
        },
        {
          "description": "No screenshot is older than what it shows.",
          "type": "string",
          "const": "screenshots"
        },
        {
          "description": "Docs describe what is there: no history, dates or backlog.",
          "type": "string",
          "const": "tone"
        },
        {
          "description": "No docs page names the last release's version after a bump.",
          "type": "string",
          "const": "versions"
        },
        {
          "description": "GitHub's checks for this commit.",
          "type": "string",
          "const": "ci"
        }
      ]
    },
    "DoneState": {
      "description": "How a part stands.",
      "oneOf": [
        {
          "description": "Done, by evidence.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "Not done: its fixes say what to do.",
          "type": "string",
          "const": "not_done"
        },
        {
          "description": "The evidence is not there (not pushed, no access, no base).",
          "type": "string",
          "const": "cant_tell"
        }
      ]
    },
    "DoneFinding": {
      "description": "One thing a line found.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        },
        "line": {
          "description": "1-based line, when it has one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "what": {
          "description": "What it is: the phrase, the missing target, the newer source.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "what"
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/pr.json"
}
