{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "new: a new project's plan, its steps, its commit and what Undo would do",
  "description": "The `new_project` payload.",
  "type": "object",
  "properties": {
    "plan": {
      "description": "The plan.",
      "$ref": "#/$defs/ProjectPlan"
    },
    "results": {
      "description": "Each step's outcome (empty on a dry run).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanStepResult"
      }
    },
    "init": {
      "description": "`speccoder init`'s report, when it ran.",
      "anyOf": [
        {
          "$ref": "#/$defs/InitReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit": {
      "description": "speccoder's commit, once made.",
      "type": [
        "string",
        "null"
      ]
    },
    "undo": {
      "description": "What Undo would do.",
      "$ref": "#/$defs/UndoOffer"
    },
    "dry_run": {
      "description": "Nothing ran.",
      "type": "boolean"
    },
    "first_feature": {
      "description": "The project's first feature, prefilled from the idea.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "plan",
    "results",
    "init",
    "commit",
    "undo",
    "dry_run",
    "first_feature"
  ],
  "$defs": {
    "ProjectPlan": {
      "description": "The plan.",
      "type": "object",
      "properties": {
        "target": {
          "description": "The folder, canonical and absolute.",
          "type": "string"
        },
        "name": {
          "description": "The project's name (the folder's).",
          "type": "string"
        },
        "mode": {
          "description": "A new folder or an existing repository.",
          "$ref": "#/$defs/ProjectMode"
        },
        "stack": {
          "description": "The stack.",
          "$ref": "#/$defs/StackPick"
        },
        "stacks": {
          "description": "Every stack and whether its tool is installed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StackOption"
          }
        },
        "format": {
          "description": "The spec format (`speckit`, `openspec`).",
          "type": "string"
        },
        "formats": {
          "description": "Every format and whether its tool is installed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormatOption"
          }
        },
        "extensions": {
          "description": "Spec Kit extensions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExtensionChoice"
          }
        },
        "preset": {
          "description": "Whether the speccoder Spec Kit preset is passed to the format's init.",
          "type": "boolean"
        },
        "steps": {
          "description": "The commands, in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanStep"
          }
        },
        "sandbox": {
          "description": "The OS sandbox.",
          "$ref": "#/$defs/SandboxNote"
        },
        "identity": {
          "description": "The person's git identity.",
          "anyOf": [
            {
              "$ref": "#/$defs/GitIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "refusal": {
          "description": "Why it cannot run (Create disabled).",
          "anyOf": [
            {
              "$ref": "#/$defs/PlanRefusal"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed": {
          "description": "The folder as seen.",
          "$ref": "#/$defs/ObservedFolder"
        },
        "digest": {
          "description": "SHA-256 over all of the above.",
          "type": "string"
        }
      },
      "required": [
        "target",
        "name",
        "mode",
        "stack",
        "stacks",
        "format",
        "formats",
        "extensions",
        "preset",
        "steps",
        "sandbox",
        "identity",
        "refusal",
        "observed",
        "digest"
      ]
    },
    "ProjectMode": {
      "description": "Where the project is made.",
      "oneOf": [
        {
          "description": "A folder that does not exist yet, or an empty one.",
          "type": "string",
          "const": "new_folder"
        },
        {
          "description": "A git repository at its top level with a clean tree and no spec project.",
          "type": "string",
          "const": "existing_repository"
        }
      ]
    },
    "StackPick": {
      "description": "How a stack was chosen.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The stack.",
          "$ref": "#/$defs/Stack"
        },
        "detected": {
          "description": "Found in an existing repository rather than chosen.",
          "type": "boolean"
        },
        "reason": {
          "description": "Why it was suggested or detected.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "detected",
        "reason"
      ]
    },
    "Stack": {
      "description": "A stack the plan can scaffold, or none.",
      "oneOf": [
        {
          "description": "Rust with cargo.",
          "type": "string",
          "const": "rust"
        },
        {
          "description": "Python with uv and pytest.",
          "type": "string",
          "const": "python"
        },
        {
          "description": "TypeScript with npm and vitest.",
          "type": "string",
          "const": "node"
        },
        {
          "description": "Go modules.",
          "type": "string",
          "const": "go"
        },
        {
          "description": "No scaffold: the person adds code.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "StackOption": {
      "description": "A stack's tool on this machine.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The stack.",
          "$ref": "#/$defs/Stack"
        },
        "label": {
          "description": "How the sheet names it.",
          "type": "string"
        },
        "version": {
          "description": "The tool's version when installed.",
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "description": "Why it cannot be chosen (its tool is missing), with the install hint.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "version",
        "disabled"
      ]
    },
    "FormatOption": {
      "description": "A spec format the plan can initialise, and its tool's state.",
      "type": "object",
      "properties": {
        "id": {
          "description": "`speckit`, `openspec`.",
          "type": "string"
        },
        "label": {
          "description": "`Spec Kit`, `OpenSpec`.",
          "type": "string"
        },
        "version": {
          "description": "The tool's version when installed.",
          "type": [
            "string",
            "null"
          ]
        },
        "disabled": {
          "description": "Why it cannot be chosen.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "version",
        "disabled"
      ]
    },
    "ExtensionChoice": {
      "description": "A Spec Kit extension the person chose.",
      "type": "object",
      "properties": {
        "source": {
          "description": "A bundled name, a local path or a URL, as given.",
          "type": "string"
        },
        "kind": {
          "description": "`bundled`, `path` or `url`.",
          "$ref": "#/$defs/ExtensionKind"
        }
      },
      "required": [
        "source",
        "kind"
      ]
    },
    "ExtensionKind": {
      "description": "What an extension source is.",
      "oneOf": [
        {
          "description": "Bundled with the format's tool (`bug`).",
          "type": "string",
          "const": "bundled"
        },
        {
          "description": "A local directory.",
          "type": "string",
          "const": "path"
        },
        {
          "description": "Downloaded: a network step.",
          "type": "string",
          "const": "url"
        }
      ]
    },
    "PlanStep": {
      "description": "One command of the plan.",
      "type": "object",
      "properties": {
        "id": {
          "description": "`git_init`, `scaffold.<n>`, `format_init`, `speccoder_init`, `commit`.",
          "type": "string"
        },
        "argv": {
          "description": "The command, exactly as it runs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "description": "Where it runs: always the target.",
          "type": "string"
        },
        "access": {
          "description": "Local, or network.",
          "$ref": "#/$defs/StepAccess"
        },
        "hosts": {
          "description": "The hosts a network step is expected to reach: shown, not enforced —\nthe step gets the full network.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writes": {
          "description": "What it writes, in one line.",
          "type": "string"
        },
        "limit_s": {
          "description": "Its time limit, in seconds.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "note": {
          "description": "A note the plan shows beside it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "argv",
        "cwd",
        "access",
        "writes",
        "limit_s"
      ]
    },
    "StepAccess": {
      "description": "Whether a step stays on the machine.",
      "oneOf": [
        {
          "description": "No network.",
          "type": "string",
          "const": "local"
        },
        {
          "description": "It gets the full network (the hosts it names are expected, not enforced).",
          "type": "string",
          "const": "network"
        }
      ]
    },
    "SandboxNote": {
      "description": "The OS sandbox the steps run in.",
      "type": "object",
      "properties": {
        "backend": {
          "description": "`seatbelt`, `landlock`; `null`: the commands run without one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "backend"
      ]
    },
    "GitIdentity": {
      "description": "The person's git identity.",
      "type": "object",
      "properties": {
        "name": {
          "description": "`user.name`.",
          "type": "string"
        },
        "email": {
          "description": "`user.email`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "email"
      ]
    },
    "PlanRefusal": {
      "description": "Why the plan cannot run, and the fix.",
      "type": "object",
      "properties": {
        "code": {
          "description": "`NEW-TARGET-NOT-EMPTY`, …",
          "type": "string"
        },
        "message": {
          "description": "What is wrong.",
          "type": "string"
        },
        "fix": {
          "description": "What to do.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "fix"
      ]
    },
    "ObservedFolder": {
      "description": "The folder and the tools as the plan saw them.",
      "type": "object",
      "properties": {
        "exists": {
          "description": "The folder exists.",
          "type": "boolean"
        },
        "entries": {
          "description": "Its entries' names, sorted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "head": {
          "description": "`HEAD`, in a repository with a commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "porcelain": {
          "description": "`git status --porcelain` lines.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "description": "Each tool's version line, by name.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "exists",
        "entries",
        "head",
        "porcelain",
        "tools"
      ]
    },
    "PlanStepResult": {
      "description": "One step's outcome.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The step.",
          "type": "string"
        },
        "state": {
          "description": "What happened.",
          "$ref": "#/$defs/PlanStepState"
        },
        "exit": {
          "description": "Its exit status, when it ran.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "duration_ms": {
          "description": "How long it took.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tail": {
          "description": "The last lines of its output (at most 20).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "state",
        "exit",
        "duration_ms",
        "output_tail"
      ]
    },
    "PlanStepState": {
      "description": "A step's state in a run.",
      "oneOf": [
        {
          "description": "Not started.",
          "type": "string",
          "const": "waiting"
        },
        {
          "description": "Running now.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Finished.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "Its effect was already there (resume).",
          "type": "string",
          "const": "skipped"
        },
        {
          "description": "Failed; later steps did not run.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "InitReport": {
      "description": "Result of `speccoder init`.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The configuration file.",
          "type": "string"
        },
        "checks": {
          "description": "The checks it declares.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/InitCheck"
          }
        },
        "model": {
          "description": "`provider/model`.",
          "type": "string"
        },
        "wrote": {
          "description": "Files written, relative to the project root.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ran": {
          "description": "The checks run on the untouched code (empty: not run).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/InitRun"
          }
        },
        "instructions": {
          "description": "The repository instructions found (`AGENTS.md`, `CLAUDE.md`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key": {
          "description": "The model key: the variable and whether it is set.",
          "$ref": "#/$defs/InitKey"
        },
        "region": {
          "description": "The region written (Bedrock only).",
          "type": [
            "string",
            "null"
          ]
        },
        "committed": {
          "description": "The commit holding `speccoder.toml`, when one was made.",
          "type": [
            "string",
            "null"
          ]
        },
        "include": {
          "description": "The git-ignored files proposed for `[worktree] include` (the\ncheckout's `.env` files): copied into each run's worktree.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_active": {
          "description": "The proposal was written as the setting (confirmed, or `--yes`);\nelse it is commented.",
          "type": "boolean",
          "default": false
        },
        "worktreeinclude": {
          "description": "The checkout has a `.worktreeinclude`, which runs read already.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "path",
        "checks",
        "model",
        "wrote",
        "ran",
        "instructions",
        "key",
        "committed",
        "include_active",
        "worktreeinclude"
      ]
    },
    "InitCheck": {
      "description": "One detected check.",
      "type": "object",
      "properties": {
        "name": {
          "description": "`[checks.<name>]`.",
          "type": "string"
        },
        "argv": {
          "description": "The command.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tier": {
          "description": "`fast` or `full`.",
          "type": "string"
        },
        "why": {
          "description": "Why it was proposed.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "argv",
        "tier",
        "why"
      ]
    },
    "InitRun": {
      "description": "One check `init` ran on the untouched code.",
      "type": "object",
      "properties": {
        "name": {
          "description": "`[checks.<name>]`.",
          "type": "string"
        },
        "passed": {
          "description": "Passed on the untouched code.",
          "type": "boolean"
        },
        "status": {
          "description": "`passed`, `failed`, `timed_out`, `skipped`, `error`.",
          "type": "string"
        },
        "duration_ms": {
          "description": "How long it took.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reason": {
          "description": "Why it did not pass: the last line of its output that says something\n(`No module named pytest`), or the runner's note.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "passed",
        "status",
        "duration_ms",
        "reason"
      ]
    },
    "InitKey": {
      "description": "The model key `init` looked for.",
      "type": "object",
      "properties": {
        "variable": {
          "description": "`ANTHROPIC_API_KEY`, `OPENAI_API_KEY`, `AWS_BEARER_TOKEN_BEDROCK`.",
          "type": "string"
        },
        "set": {
          "description": "Set in this environment (Bedrock: a credential source was found).",
          "type": "boolean"
        },
        "source": {
          "description": "Bedrock: where the AWS chain will take credentials from, by kind and\nname (`aws login session (profile dev)`), never a value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "variable",
        "set"
      ]
    },
    "UndoOffer": {
      "description": "What Undo would do.",
      "type": "object",
      "properties": {
        "available": {
          "description": "It can be undone now.",
          "type": "boolean"
        },
        "kind": {
          "description": "`trash`, `revert` or `none`.",
          "type": "string"
        },
        "reason": {
          "description": "Why not, when not.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "kind"
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/new_project.json"
}
