{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "schema: the published schemas",
  "description": "Result of `speccoder schema`.",
  "type": "object",
  "properties": {
    "names": {
      "description": "Every schema speccoder publishes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SchemaName"
      }
    },
    "schema": {
      "description": "The schema asked for."
    }
  },
  "required": [
    "names",
    "schema"
  ],
  "$defs": {
    "SchemaName": {
      "description": "One published schema.",
      "type": "object",
      "properties": {
        "name": {
          "description": "`result`, `event`, `run`, …",
          "type": "string"
        },
        "describes": {
          "description": "What it describes.",
          "type": "string"
        },
        "url": {
          "description": "Where it is published.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "describes",
        "url"
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/schema.json"
}
