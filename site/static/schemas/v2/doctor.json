{
  "$defs": {
    "BatchVerdict": {
      "description": "A batch decision.",
      "oneOf": [
        {
          "const": "approve",
          "description": "Each listed call once.",
          "type": "string"
        },
        {
          "const": "reject",
          "description": "Each listed call, with one reason.",
          "type": "string"
        }
      ]
    },
    "CodeComment": {
      "description": "One line comment of the Code view.",
      "properties": {
        "line": {
          "description": "The line (1-based).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Project-relative path.",
          "type": "string"
        },
        "quote": {
          "description": "The code on that line.",
          "type": "string"
        },
        "text": {
          "description": "The person's words.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "quote",
        "text"
      ],
      "type": "object"
    },
    "CommentAnchor": {
      "description": "What an anchored comment points at.",
      "oneOf": [
        {
          "description": "A passage of a feature document.",
          "properties": {
            "end_line": {
              "description": "Last line.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "passage",
              "type": "string"
            },
            "path": {
              "description": "Project-relative path.",
              "type": "string"
            },
            "quote": {
              "description": "The words selected.",
              "type": "string"
            },
            "quote_sha256": {
              "default": "",
              "description": "`sha256:<hex>` of the quote (filled when the draft is stored).",
              "type": "string"
            },
            "section": {
              "default": "",
              "description": "Its section's heading path (`Requirements › Functional`).",
              "type": "string"
            },
            "start_line": {
              "description": "First line (1-based).",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "path",
            "start_line",
            "end_line",
            "quote",
            "quote_sha256",
            "section"
          ],
          "type": "object"
        },
        {
          "description": "A line of the spec's changes since the last commit.",
          "properties": {
            "kind": {
              "const": "diff_line",
              "type": "string"
            },
            "line": {
              "description": "The line (1-based) on that side.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "description": "Project-relative path.",
              "type": "string"
            },
            "quote": {
              "description": "The line's text.",
              "type": "string"
            },
            "side": {
              "description": "`old` or `new`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "side",
            "line",
            "quote"
          ],
          "type": "object"
        },
        {
          "description": "A line of a shown visible test.",
          "properties": {
            "kind": {
              "const": "test_line",
              "type": "string"
            },
            "line": {
              "description": "The line (1-based).",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "description": "The test's path.",
              "type": "string"
            },
            "quote": {
              "description": "The line's text.",
              "type": "string"
            },
            "req": {
              "description": "The requirement.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "req",
            "path",
            "line",
            "quote"
          ],
          "type": "object"
        },
        {
          "description": "A finding the review shows.",
          "properties": {
            "id": {
              "description": "Its id.",
              "type": "string"
            },
            "kind": {
              "const": "finding",
              "type": "string"
            },
            "source": {
              "description": "`analyze` or `review`.",
              "type": "string"
            },
            "text": {
              "description": "Its text.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source",
            "id",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "CommentOp": {
      "description": "What a comment action does.",
      "oneOf": [
        {
          "const": "add",
          "description": "A new draft.",
          "type": "string"
        },
        {
          "const": "delete",
          "description": "Remove a draft.",
          "type": "string"
        },
        {
          "const": "keep",
          "description": "Keep an outdated draft.",
          "type": "string"
        }
      ]
    },
    "DoctorCheck": {
      "description": "One doctor check.",
      "properties": {
        "check": {
          "description": "`git`, `repository`, `project`, `config`, `key`, `sandbox`, …",
          "type": "string"
        },
        "code": {
          "description": "The catalog code of a failure or warning.",
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "description": "What was found.",
          "type": "string"
        },
        "fix": {
          "description": "How to resolve it.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/DoctorLevel",
          "description": "Pass, warn or fail."
        },
        "remedy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Remedy"
            },
            {
              "type": "null"
            }
          ],
          "description": "The fix speccoder can apply itself, on the person's yes."
        },
        "tasks": {
          "description": "The tasks a plan check names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "check",
        "level",
        "detail",
        "code",
        "fix"
      ],
      "type": "object"
    },
    "DoctorLevel": {
      "description": "How a doctor check came out.",
      "oneOf": [
        {
          "const": "pass",
          "description": "Fine.",
          "type": "string"
        },
        {
          "const": "info",
          "description": "Works fully; something optional is not set up (no signing key).",
          "type": "string"
        },
        {
          "const": "warn",
          "description": "Works, with less than it could (no spec tool).",
          "type": "string"
        },
        {
          "const": "fail",
          "description": "A run would fail or judge wrongly.",
          "type": "string"
        }
      ]
    },
    "FeatureSource": {
      "description": "Where a new feature's description comes from. Later rungs add theirs\n(an Explore brief, a promoted quick change) when they are built.",
      "oneOf": [
        {
          "description": "The person's own words.",
          "properties": {
            "kind": {
              "const": "description",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A GitHub issue's description, verbatim.",
          "properties": {
            "kind": {
              "const": "issue",
              "type": "string"
            },
            "number": {
              "description": "Its number.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "number"
          ],
          "type": "object"
        }
      ]
    },
    "NewChoices": {
      "description": "What the person chose; with the folder, everything the plan follows from.",
      "properties": {
        "extensions": {
          "default": [],
          "description": "Spec Kit extensions.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "format": {
          "description": "The spec format (`speckit`, `openspec`); `None`: Spec Kit.",
          "type": [
            "string",
            "null"
          ]
        },
        "idea": {
          "description": "What they are building, verbatim (kept for the first feature).",
          "type": "string"
        },
        "no_preset": {
          "default": false,
          "description": "Leave out the speccoder Spec Kit preset.",
          "type": "boolean"
        },
        "stack": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stack"
            },
            {
              "type": "null"
            }
          ],
          "description": "The stack; `None`: the suggestion."
        }
      },
      "required": [
        "idea",
        "stack",
        "format",
        "extensions",
        "no_preset"
      ],
      "type": "object"
    },
    "OracleOp": {
      "description": "What a change to a requirement's tests does.",
      "oneOf": [
        {
          "const": "write",
          "description": "Write the tests (the author calls, the comparison, the red check,\nthe held-out set).",
          "type": "string"
        },
        {
          "const": "reject",
          "description": "Drop one test (the input is the reason, required).",
          "type": "string"
        },
        {
          "const": "again",
          "description": "Write one test again (the input is the person's comment).",
          "type": "string"
        },
        {
          "const": "edit",
          "description": "Replace one test's content with the person's (the input).",
          "type": "string"
        },
        {
          "const": "reading",
          "description": "Say which reading of an ambiguous scenario is meant.",
          "type": "string"
        }
      ]
    },
    "PlanFrom": {
      "description": "What plan through starts from.",
      "oneOf": [
        {
          "description": "A new unit from a description.",
          "properties": {
            "description": {
              "description": "What it should do, verbatim.",
              "type": "string"
            },
            "kind": {
              "const": "create",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/FeatureSource",
              "description": "Where the description comes from."
            }
          },
          "required": [
            "kind",
            "description",
            "source"
          ],
          "type": "object"
        },
        {
          "description": "The next skill after a stop, derived from the unit's files.",
          "properties": {
            "kind": {
              "const": "continue",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "PolicyList": {
      "description": "A prefix list in `speccoder.toml`.",
      "oneOf": [
        {
          "const": "commands_prefix",
          "description": "`[commands] allow_prefix`.",
          "type": "string"
        },
        {
          "const": "network_prefix",
          "description": "`[sandbox] network_allow_prefix`.",
          "type": "string"
        }
      ]
    },
    "Reading": {
      "description": "One of the two readings of an ambiguous scenario.",
      "oneOf": [
        {
          "const": "A",
          "description": "The first author's.",
          "type": "string"
        },
        {
          "const": "B",
          "description": "The second author's.",
          "type": "string"
        }
      ]
    },
    "Remedy": {
      "description": "The fix speccoder knows and can apply itself: what it does, the exact\ncommand it amounts to, how to take it back. An interface offers it as\none action (never applies it unasked); a script reads the command.",
      "properties": {
        "command": {
          "description": "The same, as a command run in the checkout.",
          "type": "string"
        },
        "effect": {
          "description": "What it changes, in one line.",
          "type": "string"
        },
        "history": {
          "description": "It writes git history (a commit): an interface asks first.",
          "type": "boolean"
        },
        "label": {
          "description": "The action, a verb first (`Commit Cargo.lock`).",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/Runnable",
          "description": "How an interface applies it."
        },
        "undo": {
          "description": "How to take it back once applied.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "effect",
        "command",
        "undo",
        "history",
        "run"
      ],
      "type": "object"
    },
    "RunMode": {
      "description": "How a run started from the review asks for a person.",
      "oneOf": [
        {
          "const": "ask",
          "description": "*Ask on Risky Calls*: a call the policy asks about is asked inline,\nas a run from the interface does.",
          "type": "string"
        },
        {
          "const": "autopilot",
          "description": "*Autopilot*: nothing asks; a call the policy would ask about and no\nticked grant covers is refused for the run and listed afterwards.",
          "type": "string"
        }
      ]
    },
    "Runnable": {
      "description": "How an interface runs an action itself.",
      "oneOf": [
        {
          "description": "A planning skill (`speccoder spec <name> <arguments>`).",
          "properties": {
            "arguments": {
              "description": "Its arguments (the input, when one is asked for).",
              "type": "string"
            },
            "kind": {
              "const": "skill",
              "type": "string"
            },
            "name": {
              "description": "The skill.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "arguments"
          ],
          "type": "object"
        },
        {
          "description": "`speccoder run`, the feature or one task.",
          "properties": {
            "kind": {
              "const": "run",
              "type": "string"
            },
            "task": {
              "description": "One task, or the feature's ready tasks.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "`speccoder run --converge`: the ready tasks, then the assessment of\nthe code against the spec as it is now, appending what remains.",
          "properties": {
            "kind": {
              "const": "converge",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Commit exactly these planning files.",
          "properties": {
            "kind": {
              "const": "commit",
              "type": "string"
            },
            "paths": {
              "description": "Repository-relative paths.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "type": "object"
        },
        {
          "description": "Approve the task's waiting call: the one that was shown, refused\nwhen another waits now.",
          "properties": {
            "call": {
              "description": "The call's id ([`crate::PendingCall::id`]).",
              "type": "string"
            },
            "digest": {
              "description": "The digest of the call that was shown ([`crate::PendingCall::digest`]).",
              "type": "string"
            },
            "kind": {
              "const": "approve",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task",
            "call",
            "digest"
          ],
          "type": "object"
        },
        {
          "description": "Reject it (the input is the reason), bound the same way.",
          "properties": {
            "call": {
              "description": "The call's id ([`crate::PendingCall::id`]).",
              "type": "string"
            },
            "digest": {
              "description": "The digest of the call that was shown ([`crate::PendingCall::digest`]).",
              "type": "string"
            },
            "kind": {
              "const": "reject",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task",
            "call",
            "digest"
          ],
          "type": "object"
        },
        {
          "description": "Tick the task on the person's word (the input is the reason).",
          "properties": {
            "kind": {
              "const": "accept",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Skip the task (the input is the reason).",
          "properties": {
            "kind": {
              "const": "skip",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Leave a note for the task's next attempts (the input is the note).",
          "properties": {
            "kind": {
              "const": "nudge",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Rule that a held attempt's tests are right (the input is the reason).",
          "properties": {
            "kind": {
              "const": "rule",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Record the person's review of requirements (the input is the\ncomment; required to request changes).",
          "properties": {
            "ids": {
              "description": "The requirement identifiers; empty: every one not yet approved.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "review",
              "type": "string"
            },
            "verdict": {
              "description": "`approve`, `request` (changes), `clear`; `answer` (ids: the\nquestion) and `edit` / `edit-approve` (ids: the requirement) take\nthe input as the words.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ids",
            "verdict"
          ],
          "type": "object"
        },
        {
          "description": "Tell a GitHub issue it is being specified as the current feature.",
          "properties": {
            "assign": {
              "description": "Also assign it to the person.",
              "type": "boolean"
            },
            "issue": {
              "description": "The issue's number.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "issue_comment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issue",
            "assign"
          ],
          "type": "object"
        },
        {
          "description": "Record a quick change and, when `run`, run it.",
          "properties": {
            "checks": {
              "description": "When it is done: its acceptance scenarios.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "quick_change",
              "type": "string"
            },
            "request": {
              "description": "The change, in the person's words.",
              "type": "string"
            },
            "run": {
              "description": "Run it once recorded.",
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "request",
            "checks",
            "run"
          ],
          "type": "object"
        },
        {
          "description": "Commit the changes set aside before the task's run onto the\nfeature's branch, as the person's own.",
          "properties": {
            "kind": {
              "const": "keep_set_aside",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Discard them.",
          "properties": {
            "kind": {
              "const": "drop_set_aside",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Commit the setup a run stops on (an uncommitted lockfile, build\noutput not ignored) in the checkout.",
          "properties": {
            "kind": {
              "const": "fix_setup",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Pick the current feature.",
          "properties": {
            "kind": {
              "const": "feature",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Push the feature's branch and open (or update) its draft pull request.",
          "properties": {
            "kind": {
              "const": "pull_request",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Record a bug in the person's words (`speccoder bug`) and, when\n`run`, reproduce it.",
          "properties": {
            "candidate": {
              "description": "Someone else's fix to judge: a patch file or `pr:N`.",
              "type": [
                "string",
                "null"
              ]
            },
            "expected": {
              "description": "What should happen instead (one or more).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "issue": {
              "description": "The GitHub issue it comes from.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "bug_fix",
              "type": "string"
            },
            "run": {
              "description": "Reproduce it once recorded.",
              "type": "boolean"
            },
            "slug": {
              "description": "Continue a bug the format's own bug step created.",
              "type": [
                "string",
                "null"
              ]
            },
            "symptom": {
              "description": "What happens (the symptom).",
              "type": "string"
            },
            "tests": {
              "description": "The person's own reproduction tests, one per expected statement\n(`PATH::NAME`).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "unchanged": {
              "description": "What must keep working (zero or more).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "symptom",
            "expected",
            "unchanged",
            "issue",
            "tests",
            "candidate",
            "slug",
            "run"
          ],
          "type": "object"
        },
        {
          "description": "Confirm (or, with `reject`, reject: the input is the reason) a\nbug's reproductions, bound to the digest shown.",
          "properties": {
            "digest": {
              "description": "The digest the person saw.",
              "type": "string"
            },
            "kind": {
              "const": "bug_confirm",
              "type": "string"
            },
            "reject": {
              "description": "Reject instead.",
              "type": "boolean"
            },
            "task": {
              "description": "`<unit>/<task>`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task",
            "digest",
            "reject"
          ],
          "type": "object"
        },
        {
          "description": "Keep an already-satisfied bug's reproductions as a regression test:\ncommitted, the task attested (the input is the reason).",
          "properties": {
            "kind": {
              "const": "bug_keep",
              "type": "string"
            },
            "task": {
