{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spec archive: the OpenSpec archive",
  "description": "Result of `speccoder spec archive` (an OpenSpec change).",
  "type": "object",
  "properties": {
    "change": {
      "description": "The change.",
      "type": "string"
    },
    "stage": {
      "description": "`probe`, `incomplete`, `unverified`, `awaiting_confirmation`,\n`declined`, `archived` or `failed`.",
      "type": "string"
    },
    "openspec_status": {
      "description": "OpenSpec's own `{severity, code, message, fix}` from its last answer."
    },
    "unverified_tasks": {
      "description": "Tasks ticked without a speccoder verdict commit.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diff": {
      "description": "What archiving changes (`openspec show <id> --diff`), when shown.",
      "type": [
        "string",
        "null"
      ]
    },
    "archived_as": {
      "description": "Where OpenSpec moved the change.",
      "type": [
        "string",
        "null"
      ]
    },
    "totals": {
      "description": "OpenSpec's counts of added, modified, removed and renamed requirements."
    },
    "commit": {
      "description": "The commit `archive <id>`.",
      "type": [
        "string",
        "null"
      ]
    },
    "confirmed_by": {
      "description": "Who confirmed.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "change",
    "stage",
    "openspec_status",
    "unverified_tasks",
    "diff",
    "archived_as",
    "totals",
    "commit",
    "confirmed_by"
  ],
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/archive.json"
}
