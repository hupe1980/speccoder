{
  "$defs": {
    "Action": {
      "description": "One thing a person can do now.",
      "properties": {
        "blocked": {
          "description": "Why it cannot run now; `None`: it can.",
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "description": "The equivalent command; `\"…\"` marks the input.",
          "type": "string"
        },
        "confirm": {
          "description": "It leaves the machine (a push, a pull request) or cannot be undone\n(a discard): what an interface says in a confirmation before it runs it.",
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "description": "`next`, `plan`, `work`, `task`, `feature` or `review`.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ActionId",
          "description": "What it is, independent of its wording ([`identity`])."
        },
        "input": {
          "description": "What to ask for before it runs (`Describe the feature`).",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "What it does, in a few words.",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillRole"
            },
            {
              "type": "null"
            }
          ],
          "description": "A planning skill's part in its format's planning; `None` for\neverything else."
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/Runnable"
            },
            {
              "type": "null"
            }
          ],
          "description": "How an interface runs it; `None`: run the command yourself (it leaves\nthe machine, or it is not something an interface hosts)."
        },
        "why": {
          "description": "Why, or what follows (shown beside it).",
          "type": "string"
        }
      },
      "required": [
        "group",
        "label",
        "why",
        "command",
        "run",
        "blocked",
        "input",
        "confirm",
        "id",
        "role"
      ],
      "type": "object"
    },
    "ActionId": {
      "description": "What an action is, independent of its wording: its kind and what it\nis about (the task, the skill, the issue). An interface finds an action\nby this, never by its label.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActionKind",
          "description": "Its kind."
        },
        "subject": {
          "description": "What it is about: a task's id, a skill's name, an issue's number,\na review's `verdict` (`verdict:first id`), a command's words.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "subject"
      ],
      "type": "object"
    },
    "ActionKind": {
      "description": "What kind of action it is: one per [`Runnable`] kind (a run split by\nwhether it names a task), plus [`ActionKind::Command`] for an action an\ninterface does not run itself. Exhaustive at any one version; a new\nkind arrives with its `Runnable` variant (the *adding a kind* contract\nof `speccoder_runtime::actions::perform`).",
      "oneOf": [
        {
          "const": "skill",
          "description": "[`Runnable::Skill`].",
          "type": "string"
        },
        {
          "const": "run_task",
          "description": "[`Runnable::Run`] with a task.",
          "type": "string"
        },
        {
          "const": "run_feature",
          "description": "[`Runnable::Run`] without one: the feature.",
          "type": "string"
        },
        {
          "const": "converge",
          "description": "[`Runnable::Converge`].",
          "type": "string"
        },
        {
          "const": "commit",
          "description": "[`Runnable::Commit`].",
          "type": "string"
        },
        {
          "const": "approve",
          "description": "[`Runnable::Approve`].",
          "type": "string"
        },
        {
          "const": "reject",
          "description": "[`Runnable::Reject`].",
          "type": "string"
        },
        {
          "const": "accept",
          "description": "[`Runnable::Accept`].",
          "type": "string"
        },
        {
          "const": "skip",
          "description": "[`Runnable::Skip`].",
          "type": "string"
        },
        {
          "const": "nudge",
          "description": "[`Runnable::Nudge`].",
          "type": "string"
        },
        {
          "const": "rule",
          "description": "[`Runnable::Rule`].",
          "type": "string"
        },
        {
          "const": "review",
          "description": "[`Runnable::Review`].",
          "type": "string"
        },
        {
          "const": "issue_comment",
          "description": "[`Runnable::IssueComment`].",
          "type": "string"
        },
        {
          "const": "quick_change",
          "description": "[`Runnable::QuickChange`].",
          "type": "string"
        },
        {
          "const": "keep_set_aside",
          "description": "[`Runnable::KeepSetAside`].",
          "type": "string"
        },
        {
          "const": "drop_set_aside",
          "description": "[`Runnable::DropSetAside`].",
          "type": "string"
        },
        {
          "const": "fix_setup",
          "description": "[`Runnable::FixSetup`].",
          "type": "string"
        },
        {
          "const": "feature",
          "description": "[`Runnable::Feature`].",
          "type": "string"
        },
        {
          "const": "pull_request",
          "description": "[`Runnable::PullRequest`].",
          "type": "string"
        },
        {
          "const": "bug_fix",
          "description": "[`Runnable::BugFix`].",
          "type": "string"
        },
        {
          "const": "bug_confirm",
          "description": "[`Runnable::BugConfirm`].",
          "type": "string"
        },
        {
          "const": "bug_run",
          "description": "[`Runnable::BugRun`].",
          "type": "string"
        },
        {
          "const": "allow_always",
          "description": "[`Runnable::AllowAlways`].",
          "type": "string"
        },
        {
          "const": "widen_policy",
          "description": "[`Runnable::WidenPolicy`].",
          "type": "string"
        },
        {
          "const": "decide_batch",
          "description": "[`Runnable::DecideBatch`].",
          "type": "string"
        },
        {
          "const": "command",
          "description": "No runnable: the person runs the command.",
          "type": "string"
        }
      ]
    },
    "BatchVerdict": {
      "description": "A batch decision.",
      "oneOf": [
        {
          "const": "approve",
          "description": "Each listed call once.",
          "type": "string"
        },
        {
          "const": "reject",
          "description": "Each listed call, with one reason.",
          "type": "string"
        }
      ]
    },
    "InboxItem": {
      "description": "One decision waiting for a person.",
      "properties": {
        "actions": {
          "description": "The decisions, the one that moves the work forward first; each runs\nin the item's feature.",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "type": "array"
        },
        "detail": {
          "description": "What it rests on: the call, the reason, the changed requirement.",
          "type": "string"
        },
        "feature": {
          "description": "The feature.",
          "type": "string"
        },
        "group": {
          "description": "Its group: `blocked_on_you` or `ready_to_review`.",
          "type": "string"
        },
        "kind": {
          "description": "What kind, in the order of urgency: `unknown` (the calls waiting in\nthe feature's journal could not be read — some may wait for you),\n`approval` (a run waits on it),\n`ruling` (a verified attempt is held: its tests reject an\nalternative the spec allows), `gaming` (the monitor suspects a\nshortcut), `stale` (proven against an earlier wording), `question`\n(the spec leaves questions open), `review`\n(requirements not approved on their current wording), `revise`\n(changes requested on the spec), `stuck` (the\nlast attempt did not pass), `aside` (changes a run set aside),\n`commit` (planning files a run cannot\nread yet), `handoff` (every task done: review and hand it off) —\nand a bug's `bug_confirm`, `bug_cannot_reproduce`,\n`bug_unchanged_not_holding`, `bug_repro_weak`,\n`bug_already_satisfied` (the registry: `speccoder_core::inbox::Kind`).",
          "type": "string"
        },
        "since": {
          "description": "Waiting since (Unix seconds), when known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "task": {
          "description": "The task, when it is about one.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "What to decide, in a line.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "group",
        "feature",
        "task",
        "title",
        "detail",
        "since",
        "actions"
      ],
      "type": "object"
    },
    "PolicyList": {
      "description": "A prefix list in `speccoder.toml`.",
      "oneOf": [
        {
          "const": "commands_prefix",
          "description": "`[commands] allow_prefix`.",
          "type": "string"
        },
        {
          "const": "network_prefix",
          "description": "`[sandbox] network_allow_prefix`.",
          "type": "string"
        }
      ]
    },
    "Runnable": {
      "description": "How an interface runs an action itself.",
      "oneOf": [
        {
          "description": "A planning skill (`speccoder spec <name> <arguments>`).",
          "properties": {
            "arguments": {
              "description": "Its arguments (the input, when one is asked for).",
              "type": "string"
            },
            "kind": {
              "const": "skill",
              "type": "string"
            },
            "name": {
              "description": "The skill.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "arguments"
          ],
          "type": "object"
        },
        {
          "description": "`speccoder run`, the feature or one task.",
          "properties": {
            "kind": {
              "const": "run",
              "type": "string"
            },
            "task": {
              "description": "One task, or the feature's ready tasks.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "`speccoder run --converge`: the ready tasks, then the assessment of\nthe code against the spec as it is now, appending what remains.",
          "properties": {
            "kind": {
              "const": "converge",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Commit exactly these planning files.",
          "properties": {
            "kind": {
              "const": "commit",
              "type": "string"
            },
            "paths": {
              "description": "Repository-relative paths.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "paths"
          ],
          "type": "object"
        },
        {
          "description": "Approve the task's waiting call.",
          "properties": {
            "kind": {
              "const": "approve",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Reject it (the input is the reason).",
          "properties": {
            "kind": {
              "const": "reject",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Tick the task on the person's word (the input is the reason).",
          "properties": {
            "kind": {
              "const": "accept",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Skip the task (the input is the reason).",
          "properties": {
            "kind": {
              "const": "skip",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Leave a note for the task's next attempts (the input is the note).",
          "properties": {
            "kind": {
              "const": "nudge",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Rule that a held attempt's tests are right (the input is the reason).",
          "properties": {
            "kind": {
              "const": "rule",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Record the person's review of requirements (the input is the\ncomment; required to request changes).",
          "properties": {
            "ids": {
              "description": "The requirement identifiers; empty: every one not yet approved.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "review",
              "type": "string"
            },
            "verdict": {
              "description": "`approve`, `request` (changes), `clear`; `answer` (ids: the\nquestion) and `edit` / `edit-approve` (ids: the requirement) take\nthe input as the words.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ids",
            "verdict"
          ],
          "type": "object"
        },
        {
          "description": "Tell a GitHub issue it is being specified as the current feature.",
          "properties": {
            "assign": {
              "description": "Also assign it to the person.",
              "type": "boolean"
            },
            "issue": {
              "description": "The issue's number.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "issue_comment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "issue",
            "assign"
          ],
          "type": "object"
        },
        {
          "description": "Record a quick change and, when `run`, run it.",
          "properties": {
            "checks": {
              "description": "When it is done: its acceptance scenarios.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "quick_change",
              "type": "string"
            },
            "request": {
              "description": "The change, in the person's words.",
              "type": "string"
            },
            "run": {
              "description": "Run it once recorded.",
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "request",
            "checks",
            "run"
          ],
          "type": "object"
        },
        {
          "description": "Commit the changes set aside before the task's run onto the\nfeature's branch, as the person's own.",
          "properties": {
            "kind": {
              "const": "keep_set_aside",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Discard them.",
          "properties": {
            "kind": {
              "const": "drop_set_aside",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Commit the setup a run stops on (an uncommitted lockfile, build\noutput not ignored) in the checkout.",
          "properties": {
            "kind": {
              "const": "fix_setup",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Pick the current feature.",
          "properties": {
            "kind": {
              "const": "feature",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Push the feature's branch and open (or update) its draft pull request.",
          "properties": {
            "kind": {
              "const": "pull_request",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Record a bug in the person's words (`speccoder bug`) and, when\n`run`, reproduce it.",
          "properties": {
            "candidate": {
              "description": "Someone else's fix to judge: a patch file or `pr:N`.",
              "type": [
                "string",
                "null"
              ]
            },
            "expected": {
              "description": "What should happen instead (one or more).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "issue": {
              "description": "The GitHub issue it comes from.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "bug_fix",
              "type": "string"
            },
            "run": {
              "description": "Reproduce it once recorded.",
              "type": "boolean"
            },
            "slug": {
              "description": "Continue a bug the format's own bug step created.",
              "type": [
                "string",
                "null"
              ]
            },
            "symptom": {
              "description": "What happens (the symptom).",
              "type": "string"
            },
            "tests": {
              "description": "The person's own reproduction tests, one per expected statement\n(`PATH::NAME`).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "unchanged": {
              "description": "What must keep working (zero or more).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "symptom",
            "expected",
            "unchanged",
            "issue",
            "tests",
            "candidate",
            "slug",
            "run"
          ],
          "type": "object"
        },
        {
          "description": "Confirm (or, with `reject`, reject: the input is the reason) a\nbug's reproductions, bound to the digest shown.",
          "properties": {
            "digest": {
              "description": "The digest the person saw.",
              "type": "string"
            },
            "kind": {
              "const": "bug_confirm",
              "type": "string"
            },
            "reject": {
              "description": "Reject instead.",
              "type": "boolean"
            },
            "task": {
              "description": "`<unit>/<task>`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task",
            "digest",
            "reject"
          ],
          "type": "object"
        },
        {
          "description": "Continue a bug: reproduce again, or run its confirmed fix.",
          "properties": {
            "kind": {
              "const": "bug_run",
              "type": "string"
            },
            "slug": {
              "description": "A bug of the format's own bug structure, by slug.",
              "type": [
                "string",
                "null"
              ]
            },
            "task": {
              "description": "Or `<unit>/<task>`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "slug",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "Always Allow: approve the waiting command once and add exactly its\nargv to `[commands] allow` (or `[sandbox] network_allow`).",
          "properties": {
            "call": {
              "description": "The waiting call's id.",
              "type": "string"
            },
            "kind": {
              "const": "allow_always",
              "type": "string"
            },
            "task": {
              "description": "The task.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task",
            "call"
          ],
          "type": "object"
        },
        {
          "description": "Add a prefix to a prefix list, as the confirmation of its coverage\npreview (refused when the preview changed or is incomplete).",
          "properties": {
            "digest": {
              "description": "The digest of the preview the person saw.",
              "type": "string"
            },
            "key": {
              "$ref": "#/$defs/PolicyList",
              "description": "Which list."
            },
            "kind": {
              "const": "widen_policy",
              "type": "string"
            },
            "prefix": {
              "description": "The prefix (two elements or more).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "key",
            "prefix",
            "digest"
          ],
          "type": "object"
        },
        {
          "description": "Decide the calls waiting in a run's batch together, each once.",
          "properties": {
            "calls": {
              "description": "The listed calls decided (a non-empty subset).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "digest": {
              "description": "The digest of the list the person saw.",
              "type": "string"
            },
            "kind": {
              "const": "decide_batch",
              "type": "string"
            },
            "resume_asking": {
              "description": "Start the run's asking budget again.",
              "type": "boolean"
            },
            "run": {
              "description": "The run.",
              "type": "string"
            },
            "verdict": {
              "$ref": "#/$defs/BatchVerdict",
              "description": "Approve or reject (the input is the reason)."
            }
          },
          "required": [
            "kind",
            "run",
            "verdict",
            "calls",
            "digest",
            "resume_asking"
          ],
          "type": "object"
        }
      ]
    },
    "SkillRole": {
      "description": "The part a planning skill plays in its format's planning, from the\nformat's adapter: what an interface finds \"the create step\" or \"the\nanalysis step\" by, without naming a format's skill.",
      "oneOf": [
        {
          "const": "create",
          "description": "It creates a unit (Spec Kit's `specify`).",
          "type": "string"
        },
        {
          "const": "toward_tasks",
          "description": "It leads toward the task list (`plan`, `tasks`).",
          "type": "string"
        },
        {
          "const": "revise",
          "description": "It revises a written spec (`clarify`).",
          "type": "string"
        },
        {
          "const": "check",
          "description": "It checks the planning files for consistency (`analyze`).",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Anything else.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/inbox.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `speccoder inbox`: every decision that waits for a\nperson, across the project's features, the most urgent first — the\nperson's work once the agents write the code.",
  "properties": {
    "features": {
      "description": "Features looked at.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "items": {
      "description": "The items, the most urgent first (see [`InboxItem::kind`]).",
