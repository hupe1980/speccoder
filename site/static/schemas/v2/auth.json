{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "auth: who speccoder is on a GitHub host, and where its token comes from",
  "description": "Result of `speccoder auth`: who speccoder acts as on a GitHub\nhost, and where its token comes from. The token itself is never shown.",
  "type": "object",
  "properties": {
    "host": {
      "description": "`github.com` or an Enterprise host.",
      "type": "string"
    },
    "login": {
      "description": "The account, when signed in.",
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "description": "`GH_TOKEN`, `GITHUB_TOKEN`, `the keychain`, when signed in.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "host",
    "login",
    "source"
  ],
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/auth.json"
}
