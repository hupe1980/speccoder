{
  "$defs": {
    "AcceptanceRef": {
      "description": "What the fix's visible acceptance set came from.",
      "properties": {
        "pre_frozen": {
          "$ref": "#/$defs/PreFrozenRef",
          "description": "The record it reused."
        },
        "source": {
          "$ref": "#/$defs/AcceptanceSource",
          "description": "`bug_confirmation` or `person_test`."
        }
      },
      "required": [
        "source",
        "pre_frozen"
      ],
      "type": "object"
    },
    "AcceptanceSource": {
      "description": "Where a task's visible acceptance set came from.",
      "oneOf": [
        {
          "const": "authored",
          "description": "Written by the acceptance author at the run's checkpoint.",
          "type": "string"
        },
        {
          "const": "review",
          "description": "Frozen in review.",
          "type": "string"
        },
        {
          "const": "bug_confirmation",
          "description": "A bug's confirmed reproductions.",
          "type": "string"
        },
        {
          "const": "person_test",
          "description": "Tests the person named for a bug.",
          "type": "string"
        }
      ]
    },
    "AuthorClaim": {
      "description": "The author's own words, kept only as a labelled claim.",
      "properties": {
        "by": {
          "description": "Always `author`.",
          "type": "string"
        },
        "text": {
          "description": "The words.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "by"
      ],
      "type": "object"
    },
    "Basis": {
      "description": "How the person decided the reproductions.",
      "oneOf": [
        {
          "const": "shown",
          "description": "They saw the reproductions and confirmed them.",
          "type": "string"
        },
        {
          "const": "named_test",
          "description": "They named the tests themselves (`--test`).",
          "type": "string"
        }
      ]
    },
    "BugHome": {
      "description": "The bug's home, as the format adapter chose it.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/HomeKind",
          "description": "Which structure."
        },
        "location": {
          "description": "Project-relative directory (or file).",
          "type": "string"
        },
        "reason": {
          "description": "Why this one, as shown and recorded.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "location",
        "reason"
      ],
      "type": "object"
    },
    "BugOutcome": {
      "description": "The bug's outcome; distinct from a task's verdict.",
      "oneOf": [
        {
          "const": "recorded",
          "description": "The triad is recorded; nothing reproduced yet.",
          "type": "string"
        },
        {
          "const": "awaiting_confirmation",
          "description": "Every statement is reproduced; the person confirms.",
          "type": "string"
        },
        {
          "const": "cannot_reproduce",
          "description": "The tries ran out without a reproduction of every statement.",
          "type": "string"
        },
        {
          "const": "already_satisfied",
          "description": "Every reproduction passed on the untouched code, on every try.",
          "type": "string"
        },
        {
          "const": "unchanged_not_holding",
          "description": "An *Unchanged* statement does not hold today.",
          "type": "string"
        },
        {
          "const": "fixed",
          "description": "The fix was judged; see the verdict.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The fix did not pass.",
          "type": "string"
        }
      ]
    },
    "BugStage": {
      "description": "Where the bug is.",
      "oneOf": [
        {
          "const": "record",
          "description": "The triad is being recorded.",
          "type": "string"
        },
        {
          "const": "reproduce",
          "description": "Reproductions are being written and shown to fail.",
          "type": "string"
        },
        {
          "const": "confirm",
          "description": "The reproductions wait for the person's confirmation.",
          "type": "string"
        },
        {
          "const": "unchanged",
          "description": "The pass-to-pass set is chosen and run.",
          "type": "string"
        },
        {
          "const": "fix",
          "description": "The fix is attempted and judged.",
          "type": "string"
        },
        {
          "const": "ship",
          "description": "The verdict commit.",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Nothing more happens without the person.",
          "type": "string"
        }
      ]
    },
    "Candidate": {
      "description": "Someone else's fix, judged as the attempt.",
      "properties": {
        "applied": {
          "description": "It was applied as the attempt.",
          "type": "boolean"
        },
        "digest": {
          "description": "`sha256:<hex>` of the diff.",
          "type": "string"
        },
        "head_sha": {
          "description": "The pull request's head commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "description": "The pull request's number.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/CandidateOrigin",
          "description": "A patch or a pull request."
        },
        "path": {
          "description": "The patch file, as given.",
          "type": [
            "string",
            "null"
          ]
        },
        "refused": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateRefusal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why it was not."
        }
      },
      "required": [
        "origin",
        "digest",
        "applied"
      ],
      "type": "object"
    },
    "CandidateOrigin": {
      "description": "Where a foreign fix came from.",
      "oneOf": [
        {
          "const": "patch",
          "description": "A patch file.",
          "type": "string"
        },
        {
          "const": "pr",
          "description": "A GitHub pull request.",
          "type": "string"
        }
      ]
    },
    "CandidateRefusal": {
      "description": "Why a candidate was refused before it was applied.",
      "properties": {
        "code": {
          "description": "`BUG-CANDIDATE-JUDGE` or `BUG-CANDIDATE-APPLY`.",
          "type": "string"
        },
        "paths": {
          "description": "The judge paths it touches, or the hunks that did not apply.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "code",
        "paths"
      ],
      "type": "object"
    },
    "Confirmation": {
      "description": "The person's one confirmation, bound to what they saw.",
      "properties": {
        "at": {
          "description": "Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "basis": {
          "$ref": "#/$defs/Basis",
          "description": "Seen or named."
        },
        "by": {
          "description": "Who.",
          "type": "string"
        },
        "digest": {
          "description": "`sha256:<hex>` over the reproductions shown (their files and\nstatement ids).",
          "type": "string"
        },
        "triad_digest": {
          "description": "The triad's digest when confirmed: a different one lapses this.",
          "type": "string"
        },
        "via": {
          "$ref": "#/$defs/Via",
          "description": "Through what."
        }
      },
      "required": [
        "digest",
        "triad_digest",
        "by",
        "via",
        "basis",
        "at"
      ],
      "type": "object"
    },
    "FinalState": {
      "description": "A reproduction on the final tree.",
      "oneOf": [
        {
          "const": "passed",
          "description": "It passed.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "It failed.",
          "type": "string"
        },
        {
          "const": "not_run",
          "description": "Not run (no attempt yet).",
          "type": "string"
        }
      ]
    },
    "Handoff": {
      "description": "The hand-off of a stopped bug, composed by the engine from the journal\n(never written by a model).",
      "properties": {
        "claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorClaim"
            },
            {
              "type": "null"
            }
          ],
          "description": "The author's last words, labelled as its claim."
        },
        "cost": {
          "description": "Tokens the tries spent."
        },
        "elapsed_ms": {
          "description": "How long reproduce took.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "next": {
          "description": "What the person can do.",
          "items": {
            "$ref": "#/$defs/NextStep"
          },
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/BugOutcome",
          "description": "The outcome it hands off."
        },
        "statements": {
          "$ref": "#/$defs/StatementsShown",
          "description": "Per statement."
        },
        "tries": {
          "description": "The tries made.",
          "items": {
            "$ref": "#/$defs/ReproduceTry"
          },
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "tries",
        "statements",
        "elapsed_ms",
        "next"
      ],
      "type": "object"
    },
    "HeldOutVariant": {
      "description": "A held-out variant, as the payload shows it: never its content or path.",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/RedClass",
          "description": "On the untouched code."
        },
        "final": {
          "$ref": "#/$defs/FinalState",
          "description": "On the final tree."
        },
        "statement": {
          "description": "The statement it covers.",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "baseline",
        "final"
      ],
      "type": "object"
    },
    "HomeKind": {
      "description": "Where the format keeps the bug.",
      "oneOf": [
        {
          "const": "native_speckit_bug",
          "description": "Spec Kit's first-party `bug` extension: its own per-bug directory.",
          "type": "string"
        },
        {
          "const": "native_kiro_bugfix",
          "description": "Kiro's `bugfix.md` spec.",
          "type": "string"
        },
        {
          "const": "standing_speckit",
          "description": "Spec Kit without the extension: the standing bug-fix unit.",
          "type": "string"
        },
        {
          "const": "standing_openspec",
          "description": "OpenSpec: the standing bug-fix change.",
          "type": "string"
        }
      ]
    },
    "IssueRef": {
      "description": "The issue a bug was recorded from.",
      "properties": {
        "context_digest": {
          "description": "The digest of its context-manifest entry (title and body as given\nto the reproduction author).",
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "description": "Its number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repo": {
          "description": "`owner/repo`, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "number"
      ],
      "type": "object"
    },
    "MemberFinal": {
      "description": "A pass-to-pass member on the final tree.",
      "oneOf": [
        {
          "const": "passed",
          "description": "Passed, by name.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Failed.",
          "type": "string"
        },
        {
          "const": "missing",
          "description": "Not found in the final run: a failure.",
          "type": "string"
        },
        {
          "const": "not_run",
          "description": "Not run yet.",
          "type": "string"
        }
      ]
    },
    "NextStep": {
      "description": "One step a person can take.",
      "properties": {
        "command": {
          "description": "A copy-pasteable command (`\"…\"` marks text the person writes).",
          "type": "string"
        },
        "why": {
          "description": "Why, in one short line.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "why"
      ],
      "type": "object"
    },
    "PassToPass": {
      "description": "The tests that passed before the fix and must pass after it.",
      "properties": {
        "members": {
          "description": "The members.",
          "items": {
            "$ref": "#/$defs/PassToPassMember"
          },
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/PassToPassState",
          "description": "Selected, or nothing was."
        }
      },
      "required": [
        "state",
        "members"
      ],
      "type": "object"
    },
    "PassToPassMember": {
      "description": "One test that must stay green.",
      "properties": {
        "file": {
          "description": "Its file.",
          "type": "string"
        },
        "final": {
          "$ref": "#/$defs/MemberFinal",
          "description": "On the final tree."
        },
        "rule": {
          "description": "How it was selected: `same_file`, `references:<module>`,\n`imports:<path>`, `package:<pkg>`, `unchanged:U<n>`.",
          "type": "string"
        },
        "test": {
          "description": "The test id, as the runner reports it.",
          "type": "string"
        }
      },
      "required": [
        "test",
        "file",
        "rule",
        "final"
      ],
      "type": "object"
    },
    "PassToPassState": {
      "description": "Whether anything was selected for pass-to-pass.",
      "oneOf": [
        {
          "const": "selected",
          "description": "Members were selected.",
          "type": "string"
        },
        {
          "const": "none_selected",
          "description": "Nothing was: never counted as passed.",
          "type": "string"
        }
      ]
    },
    "PreFrozenRef": {
      "description": "Where the confirmed reproductions are kept, as recorded with the fix.",
      "properties": {
        "approval": {
          "description": "The confirmation's digest.",
          "type": "string"
        },
        "manifest": {
          "description": "`sha256:<hex>` over the visible set.",
          "type": "string"
        },
        "wording": {
          "description": "The triad's digest.",
          "type": "string"
        }
      },
      "required": [
        "manifest",
        "approval",
        "wording"
      ],
      "type": "object"
    },
    "RedClass": {
      "description": "What a red run of acceptance tests showed.\n\nOnly [`RedClass::Assertion`] and [`RedClass::Absent`] are red: a test was\ncollected and failed on an assertion, or the tests could not build only\nbecause symbols the task is to introduce do not exist yet. Everything\nelse is not demonstrated.",
      "oneOf": [
        {
          "const": "assertion",
          "description": "A collected test failed on an assertion.",
          "type": "string"
        },
        {
          "const": "absent",
          "description": "The only build or import errors name symbols that do not exist yet.",
          "type": "string"
        },
        {
          "const": "build_error",
          "description": "Any other build error.",
          "type": "string"
        },
        {
          "const": "collection_error",
          "description": "Tests errored at setup or collection.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "The run hit its deadline.",
          "type": "string"
        },
        {
          "const": "no_tests",
          "description": "Nothing was collected.",
          "type": "string"
        },
        {
          "const": "flaky",
          "description": "Red once, not red when confirmed.",
          "type": "string"
        },
        {
          "const": "unclassified",
          "description": "The output was not recognised.",
          "type": "string"
        },
        {
          "const": "passed",
          "description": "The tests passed.",
          "type": "string"
        }
      ]
    },
    "Rejection": {
      "description": "The person rejected the reproductions shown; the reason goes to the\nauthor's next try.",
      "properties": {
        "at": {
          "description": "Unix seconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "by": {
          "description": "Who.",
          "type": "string"
        },
        "digest": {
          "description": "The digest rejected.",
          "type": "string"
        },
        "reason": {
          "description": "Why.",
          "type": "string"
        },
        "via": {
          "$ref": "#/$defs/Via",
          "description": "Through what."
        }
      },
      "required": [
        "digest",
        "reason",
        "by",
        "via",
        "at"
      ],
      "type": "object"
    },
    "ReproduceTry": {
      "description": "One try of the reproduction author.",
      "properties": {
        "discarded": {
          "description": "Why the whole try was discarded (`wrote outside tests`, …).",
          "type": [
            "string",
            "null"
          ]
        },
        "n": {
          "description": "1, 2, …",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "per_statement": {
          "description": "Per statement.",
          "items": {
            "$ref": "#/$defs/TryStatement"
          },
          "type": "array"
        },
        "rejection": {
          "description": "The person's reason for rejecting the reproductions before it.",
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "description": "The author's run.",
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "description": "Its tokens."
        }
      },
      "required": [
        "n",
        "per_statement"
      ],
      "type": "object"
    },
    "Reproduction": {
      "description": "One reproduction test.",
      "properties": {
        "argv": {
          "description": "The command that runs only it.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "baseline": {
          "description": "Its class on the untouched code, run twice.",
          "items": {
            "$ref": "#/$defs/RedClass"
          },
          "type": "array"
        },
        "digest": {
          "description": "`sha256:<hex>` of its content.",
          "type": "string"
        },
        "file": {
          "description": "Project-relative test file.",
          "type": "string"
        },
        "final": {
          "$ref": "#/$defs/FinalState",
          "description": "On the final tree."
        },
        "revert": {
          "$ref": "#/$defs/RevertOutcome",
          "description": "Against the revert candidate."
        },
        "source": {
          "$ref": "#/$defs/ReproductionSource",
          "description": "Who wrote it."
        },
        "statement": {
          "description": "The statement it reproduces (`E1`) — or, for a test of an\n*Unchanged* statement, that one (`U1`).",
          "type": "string"
        },
        "test": {
          "description": "The test's name.",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "file",
        "test",
        "source",
        "baseline",
        "digest",
        "argv",
        "final",
        "revert"
      ],
      "type": "object"
    },
    "ReproductionSource": {
      "description": "Who wrote a reproduction.",
      "oneOf": [
        {
          "const": "author",
          "description": "The test-blind reproduction author.",
          "type": "string"
        },
        {
          "const": "person",
          "description": "The person (`--test`).",
          "type": "string"
        }
      ]
    },
    "RevertOutcome": {
      "description": "A reproduction against the revert candidate (the fix undone).",
      "oneOf": [
        {
          "const": "rejected",
          "description": "It failed on an assertion: it tells the fix from no fix.",
          "type": "string"
        },
        {
          "const": "survived",
          "description": "It passed without the fix.",
          "type": "string"
        },
        {
          "const": "unviable",
          "description": "The revert did not build: no evidence either way.",
          "type": "string"
        },
        {
          "const": "not_run",
          "description": "Not run.",
          "type": "string"
        }
      ]
    },
    "RevertResult": {
      "description": "The revert candidate's result.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/RevertOutcome",
          "description": "The gravest outcome over the reproductions."
        },
        "rejected_by": {
          "description": "The statements whose reproduction failed on an assertion.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "rejected_by"
      ],
      "type": "object"
    },
    "SealedRef": {
      "description": "A sealed held-out set: kept in the state directory, never shown.",
      "properties": {
        "count": {
          "description": "Files in it.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "description": "The requirement it is keyed by.",
          "type": "string"
        },
        "manifest_sha256": {
          "description": "The manifest's hash.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "manifest_sha256",
        "count"
      ],
      "type": "object"
    },
    "SpecialCase": {
      "description": "One special-case candidate: a fix that recognises a reproduction's\nliteral inputs.",
      "properties": {
        "digest": {
          "description": "`sha256:<hex>` of its files: what a ruling is bound to.",
          "type": "string"
        },
        "regenerated": {
          "description": "Its statement's held-out variant was written again once, told it.",
          "type": "boolean"
        },
        "rejected": {
          "description": "The combined set (reproductions and held-out variants) rejected it.",
          "type": "boolean"
        },
        "ruled": {
          "default": false,
          "description": "A person ruled the tests right about it.",
          "type": "boolean"
        },
        "statement": {
          "description": "The statement whose reproduction it targets.",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "digest",
        "rejected",
        "regenerated",
        "ruled"
      ],
      "type": "object"
    },
    "Statement": {
      "description": "One statement of the triad, in the person's words.",
      "properties": {
        "id": {
          "description": "`C` (current), `E1`, `E2`, … (expected), `U1`, … (unchanged):\npositional, stable within the requirement.",
          "type": "string"
        },
        "text": {
          "description": "The words, whitespace-normalised.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object"
    },
    "StatementsShown": {
      "description": "Statements, by what the tries showed.",
      "properties": {
        "not_reproduced": {
          "description": "Neither red nor passing.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reproduced": {
          "description": "Red by assertion in some try.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "satisfied": {
          "description": "Passed on every try.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "reproduced",
        "not_reproduced",
        "satisfied"
      ],
      "type": "object"
    },
    "Triad": {
      "description": "The person's three statements about a bug.",
      "properties": {
        "current": {
          "$ref": "#/$defs/Statement",
          "description": "What happens now (the symptom)."
        },
        "digest": {
          "description": "`sha256:<hex>` over the normalised statements: a different digest\nlapses a confirmation.",
          "type": "string"
        },
        "expected": {
          "description": "What should happen instead; at least one.",
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "type": "array"
        },
        "unchanged": {
          "description": "What must keep working as it does.",
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "type": "array"
        }
      },
      "required": [
        "current",
        "expected",
        "unchanged",
        "digest"
      ],
      "type": "object"
    },
    "TryStatement": {
      "description": "One statement's class in one try.",
      "properties": {
        "class": {
          "$ref": "#/$defs/RedClass",
          "description": "What its test did on the untouched code (`assertion` only when both\nruns failed on one)."
        },
        "excerpt": {
          "description": "Up to 20 lines of the run, when it was not red.",
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "description": "`E1`, `U1`.",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "class"
      ],
      "type": "object"
    },
    "Verdict": {
      "description": "How strong the evidence for a task is.",
      "oneOf": [
        {
          "description": "A task-specific check produced evidence, nothing failed, nothing regressed.",
          "properties": {
            "verdict": {
              "const": "verified",
              "type": "string"
            }
          },
          "required": [
            "verdict"
          ],
          "type": "object"
        },
        {
          "description": "Nothing failed or regressed, but nothing task-specific was established.",
          "properties": {
            "verdict": {
              "const": "regression_only",
              "type": "string"
            }
          },
          "required": [
            "verdict"
          ],
          "type": "object"
        },
        {
          "description": "Something failed or regressed.",
          "properties": {
            "reasons": {
              "description": "One line per reason.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "verdict": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "reasons"
          ],
          "type": "object"
        }
      ]
    },
    "Via": {
      "description": "The interface a person acted through, as a write records it (`via`):\none vocabulary for every record. Records written before it named\n`cli`, `tui` or `dashboard` (read as [`Via::Terminal`]) and\n`editor <name>` (read as [`Via::Acp`], the name a separate client).",
      "oneOf": [
        {
          "const": "terminal",
          "description": "A terminal: the line CLI, its prompts, the dashboard.",
          "type": "string"
        },
        {
          "const": "web",
          "description": "The web app, in a browser tab or the desktop window.",
          "type": "string"
        },
        {
          "const": "window",
          "description": "The desktop window, once it can tell itself from a tab.",
          "type": "string"
        },
        {
          "const": "acp",
          "description": "An editor over the Agent Client Protocol.",
          "type": "string"
        },
        {
          "const": "phone",
          "description": "A phone.",
          "type": "string"
        },
        {
          "const": "ci",
          "description": "Continuous integration.",
          "type": "string"
        },
        {
          "const": "mcp",
          "description": "A client over the Model Context Protocol.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/bug.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A bug: where it lives, the person's triad, the reproductions and how\nfar it got. The `bug` payload, and what speccoder keeps of it.",
  "properties": {
    "acceptance": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceptanceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the fix's acceptance set came from."
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Candidate"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Someone else's fix, judged."
    },
    "code": {
      "default": null,
      "description": "The code of the last stop or refusal.",
      "type": [
        "string",
        "null"
      ]
    },
    "commit": {
      "default": null,
      "description": "The verdict commit.",
      "type": [
        "string",
        "null"
      ]
    },
    "confirm_digest": {
      "default": null,
      "description": "The digest waiting for the person's confirmation.",
      "type": [
        "string",
        "null"
      ]
    },
    "confirmation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Confirmation"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The confirmation."
    },
    "handoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/Handoff"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The engine's hand-off, when it stopped."
    },
    "held_out": {
      "default": [],
      "description": "The held-out variants (never their content or path).",
      "items": {
        "$ref": "#/$defs/HeldOutVariant"
      },
      "type": "array"
    },
    "held_out_reason": {
      "description": "Why no held-out variant is sealed (the author's call failed, none\nwas red): the verdict names it, and the confirmation says it first.",
      "type": [
        "string",
        "null"
      ]
    },
    "held_out_sealed": {
      "anyOf": [
        {
          "$ref": "#/$defs/SealedRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The sealed set holding them."
    },
    "home": {
      "$ref": "#/$defs/BugHome",
      "description": "Where the format keeps it."
    },
    "issue": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The issue it came from."
    },
    "max_tries": {
      "description": "At most this many tries.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "outcome": {
      "$ref": "#/$defs/BugOutcome",
      "description": "How it stands."
    },
    "pass_to_pass": {
      "anyOf": [
        {
          "$ref": "#/$defs/PassToPass"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The tests selected to stay green."
    },
    "recorded_commit": {
      "default": null,
      "description": "The planning commit that recorded it.",
      "type": [
        "string",
        "null"
      ]
    },
    "rejections": {
      "default": [],
      "description": "Rejections of earlier reproductions.",
      "items": {
        "$ref": "#/$defs/Rejection"
      },
      "type": "array"
    },
    "reproductions": {
      "default": [],
      "description": "The reproductions (and *Unchanged* tests).",
      "items": {
        "$ref": "#/$defs/Reproduction"
      },
      "type": "array"
    },
    "requirement": {
      "description": "The requirement (`FR-003`, or `bug:<slug>`).",
      "type": "string"
    },
    "revert": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevertResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The revert candidate."
    },
    "run_id": {
      "default": null,
      "description": "The last run.",
      "type": [
        "string",
        "null"
      ]
    },
    "special_case": {
      "default": [],
      "description": "The special-case candidates.",
      "items": {
        "$ref": "#/$defs/SpecialCase"
      },
      "type": "array"
    },
    "stage": {
      "$ref": "#/$defs/BugStage",
      "description": "Where it is."
    },
    "task": {
      "description": "The task (`T003`, or `bug:<slug>`).",
      "type": "string"
    },
    "title": {
      "description": "A short title.",
      "type": "string"
    },
    "triad": {
      "$ref": "#/$defs/Triad",
      "description": "The person's words."
    },
    "tries": {
      "default": [],
      "description": "The reproduce tries.",
      "items": {
        "$ref": "#/$defs/ReproduceTry"
      },
      "type": "array"
    },
    "unit": {
      "description": "The unit, as the adapter names it (`007-bugfixes`, `bugs/<slug>`).",
      "type": "string"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/Verdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The fix's verdict, once judged."
    }
  },
  "required": [
    "home",
    "unit",
    "requirement",
    "task",
    "title",
    "triad",
    "stage",
    "outcome",
    "verdict",
    "code",
    "reproductions",
    "held_out",
    "held_out_sealed",
    "confirm_digest",
    "confirmation",
    "rejections",
    "acceptance",
    "pass_to_pass",
    "revert",
    "special_case",
    "tries",
    "max_tries",
    "handoff",
    "issue",
    "candidate",
    "recorded_commit",
    "commit",
    "run_id"
  ],
  "title": "bug: a bug, its triad, reproductions, confirmation and how far it got",
  "type": "object"
}
