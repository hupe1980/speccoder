{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "preset add: the speccoder Spec Kit preset, installed or offered",
  "description": "Result of `speccoder preset add`.",
  "type": "object",
  "properties": {
    "preset": {
      "description": "The preset's id (`speccoder`).",
      "type": "string"
    },
    "version": {
      "description": "The bundled version.",
      "type": "string"
    },
    "command": {
      "description": "The Spec Kit command, as run (or to be confirmed).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output": {
      "description": "Spec Kit's own output (its last lines).",
      "type": "string"
    },
    "state": {
      "description": "The preset as Spec Kit reports it.",
      "$ref": "#/$defs/PresetState"
    }
  },
  "required": [
    "preset",
    "version",
    "command",
    "output",
    "state"
  ],
  "$defs": {
    "PresetState": {
      "description": "The speccoder preset in a project, as Spec Kit reports it.",
      "type": "object",
      "properties": {
        "installed": {
          "description": "The installed version, when installed.",
          "type": [
            "string",
            "null"
          ]
        },
        "active_for_tasks_template": {
          "description": "`specify preset resolve tasks-template` names it.",
          "type": "boolean"
        },
        "bundled": {
          "description": "The version this speccoder bundles.",
          "type": "string"
        }
      },
      "required": [
        "installed",
        "active_for_tasks_template",
        "bundled"
      ]
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/preset.json"
}
