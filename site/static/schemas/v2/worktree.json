{
  "$defs": {
    "RefusedPath": {
      "description": "A path that blocks worktree mode.",
      "properties": {
        "path": {
          "description": "Repository-relative path.",
          "type": "string"
        },
        "reason": {
          "description": "`ignored`, `untracked` or `modified`.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://hupe1980.github.io/speccoder/schemas/v2/worktree.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result of `speccoder worktree`.",
  "properties": {
    "base": {
      "description": "Commit the branch points at.",
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "description": "`speccoder/<feature>`.",
      "type": [
        "string",
        "null"
      ]
    },
    "created": {
      "description": "Created now (`false`: reused).",
      "type": "boolean"
    },
    "feature": {
      "description": "The feature the worktree is for.",
      "type": "string"
    },
    "path": {
      "description": "Absolute worktree path.",
      "type": [
        "string",
        "null"
      ]
    },
    "project_dir": {
      "description": "Spec Kit project directory inside the worktree.",
      "type": [
        "string",
        "null"
      ]
    },
    "refused_paths": {
      "description": "Offending paths with reasons, when refused.",
      "items": {
        "$ref": "#/$defs/RefusedPath"
      },
      "type": "array"
    }
  },
  "required": [
    "feature",
    "path",
    "project_dir",
    "branch",
    "base",
    "created",
    "refused_paths"
  ],
  "title": "worktree: the feature's worktree",
  "type": "object"
}
